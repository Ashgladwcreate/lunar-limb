---
// src/components/Footer.astro
---
<footer class="bg-lime-900 text-lime-50 py-16 md:py-24">
  <div class="max-w-[1300px] mx-auto px-6 lg:px-12">
    
    <!-- BAGIAN ATAS: Identitas & Moto -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 md:gap-12 mb-16 pb-12 border-b border-lime-800/50">
      <div class="flex items-center gap-6">
        <h2 class="text-5xl lg:text-6xl font-bold tracking-tight">PPMHS</h2>
        <!-- Garis Pemisah Vertikal (Desktop) -->
        <div class="hidden md:block w-px h-16 bg-lime-700"></div>
      </div>
      
      <div class="md:flex-1">
        <h3 class="text-xl md:text-2xl lg:text-3xl font-semibold leading-snug">
          Your <span class="font-bold text-lime-400">Next Step</span> <br class="hidden md:block" />
          <span class="italic font-normal">Toward a Bright Islamic Future!</span>
        </h3>
      </div>
    </div>

    <!-- BAGIAN TENGAH: Navigasi, Kontak, dan Alamat (Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-20">
      
      <!-- Kolom 1: Tautan Cepat -->
      <div>
        <h4 class="text-xs font-bold tracking-widest text-lime-400/80 uppercase mb-6">Tautan Cepat</h4>
        <ul class="flex flex-col gap-4 text-sm font-medium">
          <li><a href="/" class="hover:text-lime-400 transition-colors">Beranda</a></li>
          <li><a href="/yayasan" class="hover:text-lime-400 transition-colors">Profil Yayasan</a></li>
          <li><a href="/program" class="hover:text-lime-400 transition-colors">Program Pendidikan</a></li>
          <li><a href="/publikasi" class="hover:text-lime-400 transition-colors">Publikasi & Berita</a></li>
          <li><a href="/pendaftaran" class="text-lime-300 hover:text-lime-400 transition-colors">Pendaftaran Santri Baru</a></li>
        </ul>
      </div>

      <!-- Kolom 2: Kontak & Sosial Media -->
      <div>
        <h4 class="text-xs font-bold tracking-widest text-lime-400/80 uppercase mb-6">Hubungi Kami</h4>
        <ul class="flex flex-col gap-6 text-sm">
          <!-- Telepon -->
          <li class="flex items-start gap-4 group">
            <div class="bg-lime-800 p-2.5 rounded-lg group-hover:bg-lime-700 transition-colors flex-shrink-0">
              <svg class="w-5 h-5 text-lime-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="mt-1">
              <p class="font-semibold mb-0.5">Telepon / WhatsApp</p>
              <a href="https://wa.me/+6285732276928" target="_blank" class="text-lime-200/80 hover:text-lime-400 transition-colors">+62 857-3227-6928</a>
            </div>
          </li>
          
          <!-- Sosial Media (Sejajar dengan Kontak) -->
          <li class="mt-2">
            <p class="text-xs font-semibold tracking-wider text-lime-400/60 uppercase mb-3">Sosial Media</p>
            <div class="flex items-center gap-4">
              <!-- Instagram -->
              <a href="https://www.instagram.com/santri_ppmhs/" target="_blank" aria-label="Instagram" class="text-lime-200 hover:text-lime-400 hover:scale-110 transition-all">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                </svg>
              </a>
              <!-- YouTube -->
              <a href="https://www.youtube.com/@santrippmhs1331" target="_blank" aria-label="YouTube" class="text-lime-200 hover:text-lime-400 hover:scale-110 transition-all">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Kolom 3 & 4: Lokasi Pesantren -->
      <div class="col-span-1 md:col-span-2 lg:col-span-2 mt-6 md:mt-0">
        <h4 class="text-xs font-bold tracking-widest text-lime-400/80 uppercase mb-6">Lokasi Pesantren</h4>
        
        <!-- KITA GANTI DIV MENJADI TAG <a> AGAR AMAN DI ASTRO -->
        <a href="https://maps.google.com/?q=Pondok+Pesantren+Miftahul+Huda+Soko+Kediri" target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 group">
          
          <!-- Ikon Pin Lokasi -->
          <div class="bg-lime-800 p-2.5 rounded-lg group-hover:bg-lime-700 transition-colors flex-shrink-0 mt-1">
            <svg class="w-6 h-6 text-lime-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>

          <!-- Teks Alamat -->
          <div>
            <h5 class="font-bold text-lg mb-2 group-hover:text-lime-400 transition-colors">Pondok Pesantren Miftahul Huda Soko</h5>
            <p class="text-lime-200/80 text-sm leading-relaxed md:max-w-md">
              Jl. Tunggul Wulung, RT.01/RW.02, <br />
              Dusun Soko, Desa Menang, Kec. Pagu, <br />
              Kab. Kediri, Jawa Timur 64183
            </p>
            <p class="text-xs font-semibold text-lime-400 mt-3 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Buka di Google Maps 
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </p>
          </div>
          
        </a>
      </div>
    </div>

      <!-- BAGIAN BAWAH: Copyright & Tautan Hukum -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-lime-800/50">
      
      <!-- Copyright & Web Developer Credit -->
      <div class="text-center md:text-left">
        <p class="text-xs font-medium tracking-widest text-lime-200/50 uppercase mb-1">
          &copy; 2026 Pondok Pesantren Miftahul Huda Soko.
        </p>
        <p class="text-[13px] font-medium tracking-wide text-lime-400/30">
          Situs web dirancang & dikembangkan oleh <span class="text-lime-400/50 font-semibold hover:text-lime-300 transition-colors cursor-default">Della Hidayati Rahman</span>
        </p>
      </div>

      <!-- Kebijakan Privasi (Data Protection) -->
      <div class="flex items-center gap-6 text-sm font-semibold text-lime-200">
        <a href="/privacy-policy" class="hover:text-lime-400 transition-colors">Kebijakan Privasi & Data</a>
        <a href="/kontak" class="hover:text-lime-400 transition-colors">Kontak Administrasi</a>
      </div>

    </div>

  </div>
</footer>