---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import kontakImg from '../assets/kontak.webp';
import Footer from '../components/footer.astro';
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kontak dan FAQ | PPMHS</title>
    <meta name="description" content="Pondok Pesantren Miftahul Huda Soko berlokasi di Kediri, Jawa Timur. Menyediakan pendidikan agama Islam berupa program kitab dan tahfidz, serta fasilitas pembelajaran yang holistik." />
  <meta name="keywords" content="Kontak Pondok Pesantren Soko, cara pendaftaran santri baru, nomor telepon ppmhs, email ppmhs" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={false} />

    <main class="max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36">
      
      <!-- JUDUL UTAMA -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-8 md:mb-8 lg:mb-12 tracking-tight md:pr-20 lg:pr-0">
        Kontak dan Layanan Informasi PPMHS
      </h1>

      <!-- HERO IMAGE DENGAN TOMBOL SCROLL -->
      <div class="relative w-full">
        <img 
          src={kontakImg.src} 
          alt="Kegiatan Yayasan Miftahul Huda Soko" 
          class="w-full h-[350px] md:h-[500px] lg:h-[650px] object-cover rounded-[2.5rem] lg:rounded-[4rem]"
        />

        <div class="wur-cutout hidden lg:flex absolute top-1/2 -translate-y-1/2 right-0 w-16 h-16 bg-lime-50 items-center justify-center z-10">
          <button 
            class="w-13 h-13 bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-950 transition-colors group cursor-pointer"
            aria-label="Scroll down"
            onclick="window.scrollBy({ top: 600, behavior: 'smooth' })"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- ==========================================
           BAGIAN 1: DAFTAR FAQ (UKURAN FONT NORMAL & RAPI)
           ========================================== -->
      <section id="faq-lengkap" class="w-full max-w-[1100px] mx-auto mt-14 md:mt-20 lg:mt-24 mb-20 lg:px-8 scroll-mt-28">
        
        <div class="inline-block bg-lime-300 text-lime-900 text-xs font-bold px-3 py-1 mb-3 uppercase tracking-widest rounded-sm">
          Tanya Jawab (FAQ)
        </div>

        <h2 class="text-xl md:text-2xl lg:text-3xl font-bold text-lime-900 mb-3 tracking-tight leading-snug max-w-3xl">
          Sebelum menghubungi kami, mungkin pertanyaan Anda telah terjawab melalui daftar informasi berikut.
        </h2>
        <p class="text-sm md:text-base text-lime-900/85 mb-8 max-w-2xl">
          Klik pada masing-masing pertanyaan di bawah ini untuk melihat penjelasan selengkapnya.
        </p>

        <div class="flex flex-col w-full border-t border-lime-900/20">
          
          <!-- FAQ 1: Biaya Pendaftaran -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah ada biaya pendaftaran?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Biaya pendaftaran pondok sudah tergabung dalam biaya bulan pertama. Oleh karena itu, pendaftar tidak perlu melakukan pembayaran biaya pendaftaran secara terpisah.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 2: Biaya Bulanan Pondok -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Berapa biaya bulanan pondok?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Biaya bulanan (syahriah) pondok pada umumnya untuk setiap santri adalah sebesar <strong>Rp500.000</strong>. Rincian komponen biaya selengkapnya dapat Anda akses pada <a href="/program#biaya-pendidikan" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 transition-colors">bagian Rincian Biaya Pendidikan</a> di halaman Program.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 3: Keringanan Biaya Bulanan -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah saya bisa mendapat keringanan biaya bulanan?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Ya, Wali Santri dapat mengajukan keringanan biaya bulanan kepada pengurus pondok dengan alasan yang dapat diterima. Silakan menghubungi pengurus pondok melalui telepon atau WhatsApp di nomor <a href="https://wa.me/+6285732276928" target="_blank" rel="noopener noreferrer" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 transition-colors">+62 857-3227-6928</a> untuk memahami prosedur lebih lanjut.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 4: Dokumen Persyaratan Pendaftaran -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Dokumen apa saja yang diperlukan untuk pendaftaran?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900/90 text-sm md:text-base leading-relaxed max-w-3xl">
                <p class="mb-3">
                  Mohon siapkan dokumen berikut dalam bentuk <span class="font-bold">file digital (foto/scan)</span> untuk diunggah pada <a href="/pendaftaran#formulir-pendaftaran" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 transition-colors">formulir pendaftaran daring</a>, serta <span class="font-semibold">berkas fisik (fotokopi) untuk diserahkan ke sekretariat</span> menjelang hari masuk:
                </p>
                <ul class="list-disc list-inside space-y-1.5 text-lime-900 font-medium">
                  <li>Kartu Keluarga (KK) dan Akta Kelahiran calon santri (file unggahan & fotokopi masing-masing 2 lembar).</li>
                  <li>KTP kedua orang tua atau wali (file unggahan & fotokopi 2 lembar).</li>
                  <li>Pas foto terbaru berbusana muslim/rapi (file unggahan & cetak ukuran 3x4 sebanyak 4 lembar).</li>
                  <li>Catatan riwayat kesehatan khusus (jika santri memiliki alergi atau kondisi medis tertentu).</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ 5: Batas Usia Calon Santri -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah ada batas usia untuk calon santri?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Tidak ada batas usia khusus bagi calon santri yang ingin mendaftar dan menempuh pendidikan di Pondok Pesantren Miftahul Huda Soko.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 6: Ketentuan Sekolah Formal (MTsN 8 Kediri) -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah harus bersekolah di sekolah tertentu jika ingin menjadi santri di PPMHS?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Tidak. Santri dibebaskan bersekolah di sekolah mana pun selama jarak tempuhnya masih memungkinkan dari PPMHS. Sebagai informasi, sebagian besar santri yang berada pada jenjang pendidikan SMP/MTs bersekolah di MTsN 8 Kediri. Pendaftaran ke MTsN 8 Kediri dapat dilakukan melalui situs web resmi sekolah berikut: <a href="https://mtsn8kediri.sch.id" target="_blank" rel="noopener noreferrer" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 transition-colors">Website Resmi MTsN 8 Kediri</a>.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 7: Kecukupan Pendaftaran Online -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah sudah cukup melakukan pendaftaran online melalui website?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Secara administrasi sudah mencukupi, namun tetap disarankan untuk melakukan kunjungan langsung ke pondok pesantren guna memastikan kecocokan lingkungan belajar bagi calon santri.
                </p>
              </div>
            </div>
          </div>

          <!-- FAQ 8: Kunjungan Terlebih Dahulu ke Pondok -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-4 md:py-5 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-base md:text-lg font-semibold text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apakah boleh melakukan kunjungan ke pondok pesantren terlebih dahulu?
              </span>
              <svg class="w-4 h-4 md:w-5 md:h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-5 pt-1 text-lime-900 text-sm md:text-base leading-relaxed max-w-3xl">
                <p>
                  Tentu boleh. Calon santri beserta orang tua atau wali sangat dipersilakan untuk berkunjung (sowan) terlebih dahulu ke Pondok Pesantren Miftahul Huda Soko guna melihat fasilitas asrama serta berkonsultasi langsung dengan pengurus pondok pada jam layanan tamu.
                </p>
              </div>
            </div>
          </div>

        </div>

      </section>

      <!-- ==========================================
           BAGIAN 2: SALURAN KONTAK & LOKASI (DI BAWAH FAQ)
           ========================================== -->
      <section id="saluran-kontak" class="w-full mx-auto mb-28 lg:px-8">
        <div class="bg-lime-100/80 rounded-[2.5rem] lg:rounded-[3.5rem] p-6 md:p-10 lg:p-14">
          
          <div class="max-w-2xl mb-10">
            <div class="inline-block bg-lime-300 text-lime-900 text-xs font-bold px-3 py-1 mb-3 uppercase tracking-widest rounded-sm">
              Hubungi Kami
            </div>
            <h2 class="text-2xl md:text-3xl font-bold text-lime-900 mb-3 tracking-tight">
              Masih Memiliki Pertanyaan Lain?
            </h2>
            <p class="text-sm md:text-base text-lime-900/80 leading-relaxed">
              Silakan hubungi pengurus sekretariat kami melalui saluran resmi di bawah ini atau kunjungi langsung lokasi pondok pesantren.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Card 1: WhatsApp & Telepon -->
            <div class="bg-lime-50 rounded-3xl p-6 flex flex-col justify-between border border-lime-900/10">
              <div>
                <h3 class="text-lg font-bold text-lime-900 mb-1.5">WhatsApp & Telepon</h3>
                <p class="text-xs md:text-sm text-lime-900 leading-relaxed mb-5">
                  Layanan konsultasi pendaftaran santri baru, pengajuan keringanan, dan konfirmasi berkas.
                </p>
              </div>
              <div>
                <p class="text-base font-bold text-lime-900 mb-2">+62 857-3227-6928</p>
                <a 
                  href="https://wa.me/+6285732276928?text=Assalamu'alaikum,%20saya%20ingin%20bertanya%20mengenai%20informasi%20pondok." 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-lime-900 underline decoration-lime-900/40 underline-offset-4 hover:text-lime-700 transition-colors group"
                >
                  <span>Chat via WhatsApp</span>
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Card 2: Email Resmi -->
            <div class="bg-lime-50 rounded-3xl p-6 flex flex-col justify-between border border-lime-900/10">
              <div>
                <h3 class="text-lg font-bold text-lime-900 mb-1.5">Email Sekretariat</h3>
                <p class="text-xs md:text-sm text-lime-900 leading-relaxed mb-5">
                  Untuk surat-menyurat resmi, kerja sama kelembagaan, dan pengiriman dokumen digital.
                </p>
              </div>
              <div>
                <p class="text-base font-bold text-lime-900 mb-2 break-all">ppmhs2016@gmail.com</p>
                <a 
                  href="mailto:ppmhs2016@gmail.com" 
                  class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-lime-900 underline decoration-lime-900/40 underline-offset-4 hover:text-lime-700 transition-colors group"
                >
                  <span>Kirim Email</span>
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Card 3: Alamat & Kunjungan -->
            <div class="bg-lime-50 rounded-3xl p-6 flex flex-col justify-between border border-lime-900/10">
              <div>
                <h3 class="text-lg font-bold text-lime-900 mb-2">Informasi Lokasi Pondok</h3>
                <p class="text-xs font-bold uppercase tracking-wider text-lime-900/60 mb-1">
                  Alamat Surat & Kunjungan:
                </p>
                <p class="text-xs md:text-sm text-lime-900/80 leading-relaxed mb-5">
                  <strong class="text-lime-900">(PP Miftahul Huda Soko)</strong><br />
                  Jl. Tunggul Wulung, RT.01/RW.02, Dusun Soko, Desa Menang, Kec. Pagu, Kab. Kediri, Jawa Timur 64183
                </p>
              </div>
              <div>
                <div class="text-xs mb-3 space-y-0.5">
                  <p class="font-semibold text-lime-900">Buka Setiap Hari: 09.00 - 17.00 WIB</p>
                  <p class="font-medium text-lime-900/65">Jam Istirahat: 12.00 - 15.00 WIB</p>
                </div>
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=PP+Miftahul+Huda+Soko+Jl.+Tunggul+Wulung+Desa+Menang+Kec.+Pagu+Kab.+Kediri+Jawa+Timur+64183" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-lime-900 underline decoration-lime-900/40 underline-offset-4 hover:text-lime-700 transition-colors group"
                >
                  <span>Buka di Google Maps</span>
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>
    <Footer />

  </body>

  <style>
    /* 1. Main container cutout */
    .wur-cutout {
      border-top-left-radius: 32px;
      border-bottom-left-radius: 32px;
    }

    /* 2. Inverse curves */
    .wur-cutout::before,
    .wur-cutout::after {
      content: "";
      position: absolute;
      right: 0;
      width: 32px;
      height: 32px;
      background: transparent;
      pointer-events: none;
    }

    /* 3. Top Inverse Corner */
    .wur-cutout::before {
      bottom: 100%;
      background: radial-gradient(circle at 0 0, transparent 31.5px, #f7fee7 32px);
    }

    /* 4. Bottom Inverse Corner */
    .wur-cutout::after {
      top: 100%;
      background: radial-gradient(circle at 0 100%, transparent 31.5px, #f7fee7 32px);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const accBtns = document.querySelectorAll('.accordion-btn');
      
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          const chevron = this.querySelector('.chevron');
          const isOpen = content.style.maxHeight;

          document.querySelectorAll('.accordion-content').forEach(c => {
            c.style.maxHeight = null;
          });
          document.querySelectorAll('.chevron').forEach(c => {
            c.classList.remove('rotate-180');
          });

          if (!isOpen) {
            content.style.maxHeight = content.scrollHeight + "px";
            chevron.classList.add('rotate-180');
          }
        });
      });
    });
  </script>
  
</html>