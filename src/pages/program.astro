---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import pilihanImg from '../assets/pilihanprogram.png';
import kitabImg from '../assets/kitab.jpg';
import tahsinImg from '../assets/spiritual.jpg';
import ibadahImg from '../assets/ibadah.jpg';
import kreativitasImg from '../assets/kreativiti.jpeg';
import tahfidzImg from '../assets/tahfidz.jpg';
import setoranImg from '../assets/setoran.jpg';
import murajaahImg from '../assets/murajaah.png';
import simaanImg from '../assets/simaan.jpg';
import tajwidImg from '../assets/tahsin.jpg';
import Footer from '../components/footer.astro';

---

<!-- Added 'scroll-smooth' here so clicking the links glides down the page smoothly -->
<html lang="id" class="scroll-smooth">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pilihan Program</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={false} />

    <main class="max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36">
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-8 md:mb-8 lg:mb-12 tracking-tight md:pr-20 lg:pr-0">
        Pilihan Program di PPMHS
      </h1>

      <!-- The parent is now flex-col on mobile, block on desktop -->
      <div class="flex flex-col lg:block relative w-full lg:rounded-[4rem] lg:overflow-hidden lg:bg-lime-50">
        
        <!-- Image: Fully rounded with shadow on mobile. On desktop, it loses these so the parent can clip it smoothly -->
        <img 
          src={pilihanImg.src} 
          alt="Program Pendidikan di PPMHS" 
          class="w-full h-[350px] md:h-[500px] lg:h-[650px] object-cover rounded-[2.5rem] lg:rounded-none"
        />

        <!-- ==========================================
             LEFT CUTOUT: Quick Navigation Menu
             ========================================== -->
        <!-- On mobile: transparent, no padding, spaced below image (mt-4). 
             On desktop: absolute, lime-50 background, 20px padding (p-5) -->
        <div class="wur-top-left-cutout flex flex-col relative lg:absolute top-0 left-0 z-10 w-full lg:w-auto bg-transparent lg:bg-lime-50 p-0 lg:p-5 mt-4 md:mt-6 lg:mt-0">
          
          <!-- Inner Menu Box: width matches image on mobile, gets exactly rounded-[2.5rem] to match. Desktop uses 2rem. -->
          <div class="flex flex-col w-full lg:w-[320px] bg-lime-300 rounded-[2.5rem] lg:rounded-[2rem] p-6 md:p-8 shadow-sm">
            
            <h3 class="text-lg lg:text-xl font-semibold text-lime-900 mb-4">Langsung menuju:</h3>
            
            <ul class="flex flex-col w-full">
              
              <!-- Link 1: Program Kitab -->
              <li>
                <a href="#program-kitab" class="py-4 flex justify-between items-center group focus:outline-none">
                  <span class="text-base font-base text-lime-900 group-hover:text-lime-700 transition-colors">
                    Program Kitab
                  </span>
                  <svg class="w-5 h-5 text-lime-700 transition-transform duration-300 group-hover:translate-y-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </a>
              </li>

              <!-- Link 2: Program Tahfidz -->
              <li class="border-t border-b border-lime-900/50">
                <a href="#program-tahfidz" class="py-4 flex justify-between items-center group focus:outline-none">
                  <span class="text-base font-base text-lime-900 group-hover:text-lime-700 transition-colors">
                    Program Tahfidz
                  </span>
                  <svg class="w-5 h-5 text-lime-700 transition-transform duration-300 group-hover:translate-y-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </a>
              </li>

              <li class="border-b border-lime-900/50">
                <a href="#biaya-pendidikan" class="py-4 flex justify-between items-center group focus:outline-none">
                  <span class="text-base font-base text-lime-900 group-hover:text-lime-700 transition-colors">
                    Biaya Pendidikan
                  </span>
                  <svg class="w-5 h-5 text-lime-700 transition-transform duration-300 group-hover:translate-y-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </a>
              </li>
              
            </ul>
          </div>
        </div>

        <!-- ==========================================
             RIGHT CUTOUT: Scroll Button (Stays hidden on mobile)
             ========================================== -->
        <div class="wur-cutout hidden lg:flex absolute top-1/2 -translate-y-1/2 right-0 w-16 h-16 bg-lime-50 items-center justify-center z-10">
          <button 
            class="w-[52px] h-[52px] bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-800 transition-colors group cursor-pointer"
            aria-label="Scroll down"
            onclick="window.scrollBy({ top: 600, behavior: 'smooth' })"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>
        </div>
      
      </div>

      <!-- Main Text and Dummy Sections remain unchanged -->
      <section class="w-full max-w-[1300px] mx-auto mt-16 md:mt-24 lg:mt-32 mb-12 md:mb-18 lg:px-12">
        <h2 class="max-w-4xl mx-auto text-2xl md:text-3xl lg:text-3xl text-center font-medium text-lime-900 leading-relaxed lg:leading-snug">
          Baik ingin mendalami Bahasa Arab, hukum Islam, Fiqih, atau hafalan; Pondok Pesantren Miftahul Huda Soko menawarkan pilihan program yang dapat disesuaikan dengan tujuan Anda dan Anak Anda.
        </h2>
      </section>

      <section id="program-kitab" class="w-full max-w-[1300px] mx-auto pt-24 mb-16">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-stretch">
          <!-- Left Column: Image (1/4 Width / col-span-3) -->
          <div class="lg:col-span-3 w-full h-full">
            <!-- Removed aspect ratio, added h-full so it grows with the text column -->
            <img 
              src={kitabImg.src} 
              alt="Program Kitab PPMHS" 
              class="w-full h-full object-cover rounded-[1.5rem] shadow-sm"
            />
          </div>
          <!-- Right Column: Content (3/4 Width / col-span-9) -->
          <div class="lg:col-span-9 flex flex-col justify-center py-2 lg:py-6">
            <!-- Tag / Badge -->
            <div class="inline-block bg-lime-300 text-lime-900 text-xs md:text-sm font-bold px-3 py-1 mb-4 uppercase tracking-widest rounded-sm self-start">
              Program Kitab
            </div>
            <!-- Big Heading -->
            <h2 class="text-2xl lg:text-4xl font-bold text-lime-900 mb-6 tracking-tight leading-tight">
              Ingin mendalami falsafah islam?
            </h2>
            <!-- Editorial Paragraph -->
            <p class="text-lg lg:text-2xl text-lime-800 leading-relaxed font-medium lg:mb-20">
              Jika Anda mendambakan generasi yang mampu mendalami khazanah keilmuan Islam klasik, Program Kitab menawarkan kurikulum yang dirancang khusus untuk menguasai literatur ulama salaf. Program ini memadukan pemahaman mendalam tentang tata bahasa Arab, fiqih, tafsir, serta hadits, sehingga membekali para santri dengan pondasi keagamaan yang kokoh dan kerangka berpikir yang kritis.
            </p>
          </div>

        </div>

        <div class="w-full mt-12 md:mt-24">
          
          <!-- Section Header & Mobile Navigation Arrows -->
          <div class="flex items-end justify-between mb-8">
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-lime-900 tracking-tight mr-9">
              Kegiatan Santri Program Kitab
            </h3>
            
            <div class="flex lg:hidden gap-2">
              <!-- Previous Button -->
              <button id="btn-kegiatan-prev" class="w-[40px] h-[40px] bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-800 transition-colors group cursor-pointer" aria-label="Geser ke kiri">
                <!-- Straight Arrow Left -->
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
              </button>
              
              <!-- Next Button -->
              <button id="btn-kegiatan-next" class="w-[40px] h-[40px] bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-800 transition-colors group cursor-pointer" aria-label="Geser ke kanan">
                <!-- Straight Arrow Right -->
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Cards Container -->
          <div id="kegiatan-container" class="flex flex-row gap-4 lg:gap-6 overflow-x-auto lg:overflow-hidden snap-x snap-mandatory no-scrollbar pb-4">
            
            <!-- Card 1 (Active by default) -->
            <div class="kegiatan-card active flex flex-col flex-shrink-0 w-[85vw] md:w-[45vw] lg:w-auto snap-center group cursor-default">
              <div class="w-full h-[220px] lg:h-[300px] rounded-[1.5rem] overflow-hidden mb-4">
                <img src={ibadahImg.src} alt="Menambah Ibadah Sunnah Rutin" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <!-- Added lg:h-[160px] here to lock the height and prevent wiggling -->
              <div class="flex flex-col lg:h-[160px]">
                <h4 class="kegiatan-title text-lg lg:text-xl font-bold text-lime-700 transition-colors duration-500">Menambah Ibadah Sunnah Rutin</h4>
                <div class="kegiatan-desc-wrapper overflow-hidden">
                  <p class="kegiatan-desc text-base text-lime-900 leading-relaxed pt-2 w-full pr-4 lg:pr-8">
                    Pembiasaan shalat dhuha, tahajud, dan puasa sunnah secara konsisten guna menanamkan karakter spiritual dan kedisiplinan sejak dini.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="kegiatan-card flex flex-col flex-shrink-0 w-[85vw] md:w-[45vw] lg:w-auto snap-center group cursor-default">
              <div class="w-full h-[220px] lg:h-[300px] rounded-[1.5rem] overflow-hidden mb-4">
                <img src={pilihanImg.src} alt="Kegiatan Mengaji Kitab" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <!-- Added lg:h-[160px] here -->
              <div class="flex flex-col lg:h-[160px]">
                <h4 class="kegiatan-title text-lg lg:text-xl font-bold text-lime-700 transition-colors duration-500">Kegiatan Mengaji Kitab</h4>
                <div class="kegiatan-desc-wrapper overflow-hidden">
                  <p class="kegiatan-desc text-base text-lime-900 leading-relaxed pt-2 w-full pr-4 lg:pr-8">
                    Pendalaman makna dan tata bahasa melalui pengajian kitab kuning secara komprehensif bersama jajaran asatidz berpengalaman.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="kegiatan-card flex flex-col flex-shrink-0 w-[85vw] md:w-[45vw] lg:w-auto snap-center group cursor-default">
              <div class="w-full h-[220px] lg:h-[300px] rounded-[1.5rem] overflow-hidden mb-4">
                <img src={tahsinImg.src} alt="Bimbingan Baca Qur'an" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <!-- Added lg:h-[160px] here -->
              <div class="flex flex-col lg:h-[160px]">
                <h4 class="kegiatan-title text-lg lg:text-xl font-bold text-lime-700 transition-colors duration-500">Bimbingan Tilawah Al-Qur'an</h4>
                <div class="kegiatan-desc-wrapper overflow-hidden">
                  <p class="kegiatan-desc text-base text-lime-900 leading-relaxed pt-2 w-full pr-4 lg:pr-8">
                    Pendampingan intensif tahsin dan tartil untuk memastikan setiap santri memiliki kelancaran dan ketepatan makhraj dalam membaca ayat suci.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="kegiatan-card flex flex-col flex-shrink-0 w-[85vw] md:w-[45vw] lg:w-auto snap-center group cursor-default">
              <div class="w-full h-[220px] lg:h-[300px] rounded-[1.5rem] overflow-hidden mb-4">
                <img src={kreativitasImg.src} alt="Kegiatan Kreativitas Santri" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <!-- Added lg:h-[160px] here -->
              <div class="flex flex-col lg:h-[160px]">
                <h4 class="kegiatan-title text-lg lg:text-xl font-bold text-lime-700 transition-colors duration-500">Kegiatan Kreativitas Santri</h4>
                <div class="kegiatan-desc-wrapper overflow-hidden">
                  <p class="kegiatan-desc text-base text-lime-900 leading-relaxed pt-2 w-full pr-4 lg:pr-8">
                    Wadah interaktif bagi santri untuk mengembangkan bakat dan keterampilan kepemimpinan melalui berbagai ekstrakurikuler positif dan mubalaghah rutin.
                  </p>
                </div>
              </div>
            </div>

          </div>
        </div>


        <div class="w-full mt-12">
          
          <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-lime-900 mb-6 lg:mb-10 tracking-tight">
            Kurikulum Pembelajaran
          </h3>

          <div class="flex flex-col w-full border-t border-lime-900/20">
            
            <!-- ACCORDION 1: Tahun 1 -->
            <div class="border-b border-lime-900/20 accordion-item">
              <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none accordion-btn group">
                <span class="text-xl lg:text-2xl font-medium text-lime-900 group-hover:text-lime-700 transition-colors">Tahun 1</span>
                <svg class="w-5 h-5 text-lime-900 transform transition-transform duration-300 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
                <div class="pb-8 pt-2">
                  <div class="overflow-x-auto no-scrollbar">
                    <table class="w-full text-left border-collapse min-w-[600px]">
                      <thead>
                        <tr class="border-b-2 border-lime-800 text-lime-800 text-lg">
                          <th class="py-3 px-4 font-bold w-1/4">Nama Kitab</th>
                          <th class="py-3 px-4 font-bold w-1/4">Pengarang</th>
                          <th class="py-3 px-4 font-bold w-1/2">Topik</th>
                        </tr>
                      </thead>
                      <!-- Changed to border-b border-lime-800/30 -->
                      <tbody class="text-lime-900/90 text-base border-b border-lime-800/30">
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Alala (Kumpulan Syair dari Kitab Ta'lim Muta'allim)</td>
                          <td class="py-4 px-4">Imam Al-Zarnuji</td>
                          <td class="py-4 px-4">37 bait syair berbahasa Arab yang memuat syarat mencari ilmu, adab kepada guru dan ilmu, hubungan sosial, dan disiplin diri.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Jurumiyah</td>
                          <td class="py-4 px-4">Ibnu Ajurrum</td>
                          <td class="py-4 px-4">Dasar Ilmu Nahwu (tata bahasa Arab) yang dikelompokkan dalam beberapa bab utama: Kalam, I'rab, Tanda-Tanda I'rab, Fi'il, dan Isim.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Bahasa Arab</td>
                          <td class="py-4 px-4">Kurikulum PPMHS</td>
                          <td class="py-4 px-4">Memperkaya kosa kata Bahasa Arab, khususnya yang sering ditemukan dalam kehidupan sehari-hari. Mata pelajaran ini jiga digunakan sebagai pelengkap Kitab Jurumiyah</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Khulasah Nurul Yaqin Jilid 1</td>
                          <td class="py-4 px-4">Syaikh Umar Abdul Jabbar</td>
                          <td class="py-4 px-4">Kitab ini merupakan ringkasan dari kitab induk Nurul Yaqin fi Sirati Sayyidil Mursalin karya Syekh Muhammad Khudhari Beik yang membahas asal-usul atau nasab Nabi Muhammad SAW serta berbagai peristiwa penting sebelum beliau diangkat menjadi rasul.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Aqidatul Awam</td>
                          <td class="py-4 px-4">Sayyid Ahmad al-Marzuqi al-Maliki</td>
                          <td class="py-4 px-4">Kitab ini berisi 57 bait syair tentang dasar-dasar ilmu tauhid Ahlussunnah wal Jamaah yang ditujukan untuk pemula atau masyarakat awam. Bahasan tauhid mencakup: sifat bagi Allah, sifat bagi rasul/nabi, malaikat, kitab, dan sejarah Rasulullah.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Shorof/Tashrif Istilahi</td>
                          <td class="py-4 px-4">KH. Muhammad Ma'shum bin Ali</td>
                          <td class="py-4 px-4">Kitab ini memuat kaidah perubahan bentuk kata dalam bahasa Arab secara sistematis, yang terbagi menjadi dua metode utama: Tashrif Istilahi dan Tashrif Lughawi.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Menulis Makna Kitab (pego)</td>
                          <td class="py-4 px-4">-</td>
                          <td class="py-4 px-4">Melatih santri memaknai kitab tidak hanya dari segi arti, tetapi juga kedudukan kata dalam kalimat bahasa Arab.</td>
                        </tr>
                        <tr>
                          <td class="py-4 px-4 font-medium text-lime-900">Syifaul Jinan</td>
                          <td class="py-4 px-4">KH. Ahmad Muthohhar bin Abdurrahman</td>
                          <td class="py-4 px-4">Kitab ini merupakan terjemahan dan penjelasan rinci dalam bahasa Jawa (menggunakan aksara Pegon) dari kitab nadzam Hidayatush Shibyan fi Tajwidil Quran karya Syekh Said bin Said Al-Hadhrami mengenai kaidah dasar ilmu tajwid.</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ACCORDION 2: Tahun 2 -->
            <div class="border-b border-lime-900/20 accordion-item">
              <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none accordion-btn group">
                <span class="text-xl lg:text-2xl font-medium text-lime-900 group-hover:text-lime-700 transition-colors">Tahun 2</span>
                <svg class="w-5 h-5 text-lime-900 transform transition-transform duration-300 chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
                <div class="pb-8 pt-2">
                  <div class="overflow-x-auto no-scrollbar">
                    <table class="w-full text-left border-collapse min-w-[600px]">
                      <thead>
                        <tr class="border-b-2 border-lime-800 text-lime-800 text-lg">
                          <th class="py-3 px-4 font-bold w-1/4">Nama Kitab</th>
                          <th class="py-3 px-4 font-bold w-1/4">Pengarang</th>
                          <th class="py-3 px-4 font-bold w-1/2">Topik</th>
                        </tr>
                      </thead>
                      <!-- Changed to border-b border-lime-800/30 -->
                      <tbody class="text-lime-900/90 text-base border-b border-lime-800/30">
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Khulasah Nurul Yaqin Jilid 2</td>
                          <td class="py-4 px-4">Syaikh Umar Abdul Jabbar</td>
                          <td class="py-4 px-4">Kelanjutan dari jilid 1, kitab jilid 2 membahas perjalanan hidup dan dakwah Nabi Muhammad SAW setelah diangkat menjadi rasul (periode Makkah dan Madinah).</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Imrithi</td>
                          <td class="py-4 px-4">Syaikh Syarafuddin Yahya al-Imrithi</td>
                          <td class="py-4 px-4">Kitab ini berisi kaidah tata bahasa Arab (ilmu nahwu) yang disajikan dalam bentuk bait-bait syair (nazham) sebagai pengembangan dari kitab Matan Jurumiyah.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Qami'uth Thughyan</td>
                          <td class="py-4 px-4">Syaikh Muhammad Nawawi bin Umar al-Bantani</td>
                          <td class="py-4 px-4">Kitab ini membahas secara rinci mengenai 77 cabang keimanan (Syu'ab al-Iman) berdasarkan hadis yang diriwayatkan oleh Imam Muslim. Kitab ini  merupakan penjelasan atau penjabaran dari risalah nazam (syair) karya Syaikh Zainuddin bin Ali bin Ahmad asy-Syafi'i al-Kusyini al-Malibari.</td>
                        </tr>
                        <tr class="border-b border-lime-800/30">
                          <td class="py-4 px-4 font-medium text-lime-900">Bahasa Arab</td>
                          <td class="py-4 px-4">Kurikulum PPMHS</td>
