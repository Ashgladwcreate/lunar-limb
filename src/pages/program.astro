    <script>
      document.addEventListener('DOMContentLoaded', () => {
        
        // --- 1. Desktop Accordion Hover Logic (Scoped per Section) ---
        const sliders = [
          document.getElementById('kegiatan-container'),
          document.getElementById('kegiatan-container-tahfidz')
        ];

        sliders.forEach(slider => {
          if (!slider) return; 
          
          const cards = slider.querySelectorAll('.kegiatan-card');
          
          // Force the first card to be expanded by default on page load
          cards.forEach(c => c.classList.remove('active'));
          if (cards.length > 0) cards[0].classList.add('active');

          // Change active card on hover and KEEP it active
          cards.forEach(card => {
            card.addEventListener('mouseenter', () => {
              cards.forEach(c => c.classList.remove('active'));
              card.classList.add('active');
            });
          });
        });

        // --- 2. Mobile Arrow Scrolling Logic (KITAB) ---
        const containerKitab = document.getElementById('kegiatan-container');
        const btnPrevKitab = document.getElementById('btn-kegiatan-prev');
        const btnNextKitab = document.getElementById('btn-kegiatan-next');

        if (containerKitab && btnPrevKitab && btnNextKitab) {
          btnPrevKitab.addEventListener('click', () => {
            const cardWidth = containerKitab.querySelector('.kegiatan-card').offsetWidth;
            containerKitab.scrollBy({ left: -(cardWidth + 16), behavior: 'smooth' });
          });
          btnNextKitab.addEventListener('click', () => {
            const cardWidth = containerKitab.querySelector('.kegiatan-card').offsetWidth;
            containerKitab.scrollBy({ left: cardWidth + 16, behavior: 'smooth' });
          });
        }

        // --- 3. Mobile Arrow Scrolling Logic (TAHFIDZ) ---
        const containerTahfidz = document.getElementById('kegiatan-container-tahfidz');
        const btnPrevTahfidz = document.getElementById('btn-kegiatan-prev-tahfidz');
        const btnNextTahfidz = document.getElementById('btn-kegiatan-next-tahfidz');

        if (containerTahfidz && btnPrevTahfidz && btnNextTahfidz) {
          btnPrevTahfidz.addEventListener('click', () => {
            const cardWidth = containerTahfidz.querySelector('.kegiatan-card').offsetWidth;
            containerTahfidz.scrollBy({ left: -(cardWidth + 16), behavior: 'smooth' });
          });
          btnNextTahfidz.addEventListener('click', () => {
            const cardWidth = containerTahfidz.querySelector('.kegiatan-card').offsetWidth;
            containerTahfidz.scrollBy({ left: cardWidth + 16, behavior: 'smooth' });
          });
        }

        // --- 4. Curriculum Accordion Logic ---
        const accBtns = document.querySelectorAll('.accordion-btn');
        
        accBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            const content = this.nextElementSibling;
            const chevron = this.querySelector('.chevron');
            const isOpen = content.style.maxHeight;

            // Close all accordions
            document.querySelectorAll('.accordion-content').forEach(c => {
              c.style.maxHeight = null;
            });
            document.querySelectorAll('.chevron').forEach(c => {
              c.classList.remove('rotate-180');
            });

            // Open clicked accordion if it was closed
            if (!isOpen) {
              content.style.maxHeight = content.scrollHeight + "px";
              chevron.classList.add('rotate-180');
            }
          });
        });
        
      });
    </script>

