---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import heroImg from '../assets/Fasilitas/Sampul.jpg';
import mushalaImg from '../assets/Fasilitas/Mushala2.jpg';
import aulaImg from '../assets/Fasilitas/Aula.jpg';
import belajarImg from '../assets/Fasilitas/Gedung belajar.jpg';
import kelasImg from '../assets/Fasilitas/Kelas.jpg';
import siaranImg from '../assets/Fasilitas/Siaran.jpg';
import asramapaImg from '../assets/Fasilitas/AsramaPutra.jpg';
import asramapiImg from '../assets/Fasilitas/Asrama.jpg';
import gdtahfidzImg from '../assets/Fasilitas/Gedung Tahfidz.jpg';
import poskestrenImg from '../assets/Fasilitas/Poskestren.jpg';
import dapurImg from '../assets/Fasilitas/Dapur.jpg';
import kantinImg from '../assets/Fasilitas/Kantin.jpg';
import laundryImg from '../assets/Fasilitas/Laundry.jpg';
import lapanganImg from '../assets/Fasilitas/Lapangan.jpg';
import Footer from '../components/footer.astro';





// Daftar 11 Fasilitas PPMHS
// Catatan: Anda dapat mengganti properti `image: heroImg` pada masing-masing item 
// jika foto spesifik untuk setiap fasilitas sudah diimpor di atas.
const daftarFasilitas = [
  {
    kategori: "Ibadah & Spiritual",
    nama: "Mushala",
    deskripsi: "Pusat kegiatan ibadah salat berjamaah, dzikir, tadarus, serta pembinaan spiritual harian bagi para santri.",
    image: mushalaImg
  },
  {
    kategori: "Kegiatan & Kreativitas",
    nama: "Aula Serbaguna",
    deskripsi: "Ruang berkumpul utama untuk berbagai kegiatan pembelajaran bersama, pengembangan kreativitas santri, ekstrakurikuler, hingga pemutaran film edukatif.",
    image: aulaImg
  },
  {
    kategori: "Sarana Akademik",
    nama: "Gedung Belajar",
    deskripsi: "Gedung berisi kelas-kelas untuk pembelajaran santri.",
    image: belajarImg
  },
  {
    kategori: "Sarana Akademik",
    nama: "Ruang Belajar",
    deskripsi: "Area kelas yang kondusif dan tenang untuk kegiatan belajar mengajar, pendalaman kajian kitab, serta diskusi keilmuan santri.",
    image: kelasImg
  },
  {
    kategori: "Media & Komunikasi",
    nama: "Ruang Siaran",
    deskripsi: "Fasilitas penyiaran dan produksi media untuk melatih kepercayaan diri, keterampilan komunikasi publik, serta kreativitas dakwah santri.",
    image: siaranImg
  },
  {
    kategori: "Hunian Santri",
    nama: "Asrama Putra",
    deskripsi: "Kamar hunian yang nyaman bagi santri putra, dilengkapi dengan fasilitas kamar mandi dan toilet bersama yang senantiasa dijaga kebersihannya.",
    image: asramapaImg
  },
  {
    kategori: "Hunian Santri",
    nama: "Asrama Putri",
    deskripsi: "Kamar hunian santri putri yang aman dan bersih, dilengkapi kamar mandi serta toilet bersama, ditambah fasilitas khusus manajemen kesehatan menstruasi (pengelolaan pembuangan pembalut yang higienis).",
    image: asramapiImg
  },
  {
    kategori: "Hunian & Pendidikan Terpadu",
    nama: "Gedung Program Tahfidz",
    deskripsi: "Kompleks mandiri khusus santri putri Program Tahfidz yang telah dilengkapi kamar asrama, mushala, dapur, dan kantin tersendiri, serta fasilitas toilet bersama dan manajemen kesehatan menstruasi.",
    image: gdtahfidzImg
  },
  {
    kategori: "Layanan Kesehatan",
    nama: "Pos Kesehatan Pesantren",
    deskripsi: "Ruang layanan pemeriksaan kesehatan dasar, penyediaan obat-obatan pertolongan pertama, serta tempat istirahat dan pemantauan bagi santri yang membutuhkan perawatan medis.",
    image: poskestrenImg
  },
  {
    kategori: "Konsumsi & Gizi",
    nama: "Dapur Pondok",
    deskripsi: "Pusat pengolahan dan penyediaan makanan harian yang bersih dan terjadwal untuk memastikan kebutuhan gizi seluruh santri terpenuhi dengan baik.",
    image: dapurImg
  },
  {
    kategori: "Kebutuhan Harian",
    nama: "Kantin",
    deskripsi: "Tempat penyediaan aneka makanan ringan, minuman, serta kebutuhan perlengkapan harian santri yang higienis dan terjangkau di dalam area pesantren.",
    image: kantinImg
  },
  {
    kategori: "Layanan Kebersihan",
    nama: "Ruang Laundry",
    deskripsi: "Fasilitas pencucian dan penataan pakaian untuk membantu santri menjaga kerapian serta kebersihan perlengkapan ibadah dan pakaian sehari-hari.",
    image: laundryImg
  },
  {
    kategori: "Kegiatan & Kreativitas",
    nama: "Lapangan",
    deskripsi: "Lapangan terbuka yang dimanfaatkan untuk berbagai kegiatan olahraga dan aktivitas ekstrakulikuler.",
    image: lapanganImg
  }
];
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fasilitas | PPMHS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={false} />

    <main class="max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36">
      
      <!-- JUDUL UTAMA -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-8 md:mb-8 lg:mb-12 tracking-tight md:pr-20 lg:pr-0">
        Fasilitas yang Disediakan oleh PPMHS
      </h1>

      <!-- HERO IMAGE DENGAN TOMBOL SCROLL -->
      <div class="relative w-full">
        <img 
          src={heroImg.src} 
          alt="Kegiatan Yayasan Miftahul Huda Soko" 
          class="w-full h-[350px] md:h-[500px] lg:h-[650px] object-cover rounded-[2.5rem] lg:rounded-[4rem]"
        />

        <div class="wur-cutout hidden lg:flex absolute top-1/2 -translate-y-1/2 right-0 w-16 h-16 bg-lime-50 items-center justify-center z-10">
          <button 
            class="w-13 h-13 bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-950 transition-colors group cursor-pointer"
            aria-label="Scroll down"
            onclick="window.scrollBy({ top: 600, behavior: 'smooth' })"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- ==========================================
           BAGIAN 1: PENGANTAR FASILITAS
           ========================================== -->
      
      <section class="w-full max-w-[1300px] mx-auto mt-16 md:mt-24 lg:mt-32 mb-24 lg:px-12">
        
        <!-- Big Intro Text -->
        <h2 class="max-w-4xl mx-auto text-xl md:text-2xl lg:text-2xl text-center font-medium text-lime-900 leading-relaxed lg:leading-snug">
          Seluruh sarana dan prasarana di Pondok Pesantren Miftahul Huda Soko berada di dalam satu lingkungan terpadu yang aman dan mudah dijangkau oleh santri. Mulai dari ruang ibadah, ruang pengembangan minat dan kreativitas, hingga pengelolaan sanitasi dan kesehatan asrama dirancang dengan perhatian penuh agar santri dapat fokus menuntut ilmu dengan tenang dan nyaman.
        </h2>
      
      </section>

      <!-- ==========================================
           BAGIAN 2: KARTU DAFTAR FASILITAS (WUR STYLE)
           ========================================== -->
      <section id="daftar-fasilitas" class="w-full mx-auto mb-32">
        
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-lime-900 mb-8 lg:mb-10 tracking-tight">
          Sarana & Prasarana
        </h2>

        <!-- Grid 4 Kolom di Desktop, 2 di Tablet, 1 di HP -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {daftarFasilitas.map((item) => (
            <div class="bg-lime-100/80 rounded-[1.75rem] p-5 flex flex-col transition-all duration-300 ease-out hover:scale-[1.03] hover:-translate-y-1.5 hover:bg-lime-100 hover:shadow-xl hover:shadow-lime-900/10">
              
              <!-- Gambar Kartu di Bagian Atas -->
              <div class="w-full h-44 rounded-2xl overflow-hidden mb-5 bg-lime-200/50">
                <img 
                  src={item.image.src} 
                  alt={item.nama} 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <!-- Label Kategori Kecil -->
              <span class="text-[11px] font-bold uppercase tracking-widest text-lime-900/60 mb-2">
                {item.kategori}
              </span>

              <!-- Nama Fasilitas -->
              <h3 class="text-xl font-bold text-lime-900 mb-2.5 leading-snug">
                {item.nama}
              </h3>

              <!-- Deskripsi Singkat -->
              <p class="text-sm text-lime-900 leading-relaxed">
                {item.deskripsi}
              </p>

            </div>
          ))}
        </div>

      </section>

    </main>
    <Footer />

  </body>

  <style>
    /* 1. Main container cutout */
    .wur-cutout {
      border-top-left-radius: 32px;
      border-bottom-left-radius: 32px;
    }

    /* 2. Inverse curves */
    .wur-cutout::before,
    .wur-cutout::after {
      content: "";
      position: absolute;
      right: 0;
      width: 32px;
      height: 32px;
      background: transparent;
      pointer-events: none;
    }

    /* 3. Top Inverse Corner */
    .wur-cutout::before {
      bottom: 100%;
      background: radial-gradient(circle at 0 0, transparent 31.5px, #f7fee7 32px);
    }

    /* 4. Bottom Inverse Corner */
    .wur-cutout::after {
      top: 100%;
      background: radial-gradient(circle at 0 100%, transparent 31.5px, #f7fee7 32px);
    }
  </style>
</html>