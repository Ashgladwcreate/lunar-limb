---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import visimisiImg from '../assets/visimisi.png';
import spiritualImg from '../assets/spiritual.jpg';
import kemanusiaanImg from '../assets/kemanusiaan.jpg';
import alamImg from '../assets/alam.jpg';
import Footer from '../components/footer.astro';
---

<html lang="id">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visi dan Misi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={false} />

    <main class="max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36">
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-8 md:mb-8 lg:mb-12 tracking-tight md:pr-20 lg:pr-0">
        Visi dan Misi Pendidikan
      </h1>

      <div class="relative w-full">
        
        <img 
          src={visimisiImg.src} 
          alt="Kegiatan Yayasan Miftahul Huda Soko" 
          class="w-full h-[350px] md:h-[500px] lg:h-[650px] object-cover rounded-[2.5rem] lg:rounded-[4rem]"
        />

        <div class="wur-cutout hidden lg:flex absolute top-1/2 -translate-y-1/2 right-0 w-16 h-16 bg-lime-50 items-center justify-center z-10">
          
          <button 
            class="w-13 h-13 bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-950 transition-colors group cursor-pointer"
            aria-label="Scroll down"
            onclick="window.scrollBy({ top: 600, behavior: 'smooth' })"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>
          
        </div>
      
      </div>

      <section class="w-full max-w-[1300px] mx-auto mt-16 md:mt-24 lg:mt-32 mb-24 lg:px-12">
        
        <!-- Big Intro Text -->
        <h2 class="max-w-4xl mx-auto text-2xl md:text-3xl lg:text-3xl text-center font-medium text-lime-900 leading-relaxed lg:leading-snug">
          Visi dan Misi kami menjadi landasan bagi setiap langkah yang kami ambil, mulai dari tradisi pembelajaran hingga keluhuran adab yang melekat pada diri santri selama berada di lingkungan Pondok Pesantren Miftahul Huda Soko.
        </h2>
      
      </section>

     <section class="w-full max-w-[1300px] mx-auto lg:px-12 mb-24 md:mb-32">
        
        <div class="flex flex-col lg:flex-row w-full rounded-[2rem] lg:rounded-[3rem] overflow-hidden bg-lime-100/70">
          
          <!-- LEFT COLUMN: VISI -->
          <div class="w-full lg:w-1/3 bg-lime-300/80 rounded-[2rem] lg:rounded-[3rem] p-8 md:p-12 lg:p-16 flex flex-col justify-start relative z-10">
            <h2 class="text-xl md:text-2xl font-bold text-lime-900 mb-6 uppercase tracking-wider">
              Visi Kami
            </h2>
            <p class="text-2xl lg:text-3xl font-bold text-lime-800/90 leading-snug">
              "Mewujudkan generasi muda Indonesia yang berakhlakul karimah, kompetitif, kreatif, dan produktif berhaluan Ahlussunnah wal Jama'ah."
            </p>
          </div>

          <!-- RIGHT COLUMN: MISI -->
          <div class="w-full lg:w-2/3 p-8 md:p-12 lg:p-16 flex flex-col justify-start">
            <h2 class="text-xl md:text-2xl font-bold text-lime-900 mb-4 uppercase tracking-wider">
              Misi Kami
            </h2>
            
            <div>
              
              <!-- Misi 1 -->
              <div class="border-b-2 border-lime-900/70">
                <button class="misi-toggle w-full py-4 flex justify-between items-center text-left focus:outline-none group">
                  <span class="text-lg lg:text-xl font-semibold text-lime-900 group-hover:text-lime-700 transition-colors">
                    Melaksanakan Pendidikan Pesantren Salaf yang Modern
                  </span>
                  <!-- Arrow duration increased to 500ms -->
                  <svg class="arrow-icon w-6 h-6 text-lime-700 transition-transform duration-500 flex-shrink-0 ml-4 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
                <!-- Smooth Grid Wrapper -->
                <div class="misi-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="text-lime-900 text-base lg:text-lg leading-relaxed pb-4 pt-1">
                      Memadukan kedalaman kajian kitab kuning warisan ulama salaf dengan tata kelola dan fasilitas pendidikan masa kini. Kami memastikan santri mendapatkan ilmu agama yang otentik dan mendalam, namun tetap relevan, kreatif, dan kompetitif dalam menghadapi dinamika zaman.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Misi 2 -->
              <div class="border-b-2 border-lime-900/70">
                <button class="misi-toggle w-full py-4 flex justify-between items-center text-left focus:outline-none group">
                  <span class="text-lg lg:text-xl font-semibold text-lime-900 group-hover:text-lime-700 transition-colors">
                    Menanamkan Ajaran Islam Ahlussunnah wal Jamaah
                  </span>
                  <svg class="arrow-icon w-6 h-6 text-lime-700 transition-transform duration-500 flex-shrink-0 ml-4 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
                <div class="misi-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="text-lime-900 text-base lg:text-lg leading-relaxed pb-4 pt-1">
                      Membekali santri dengan aqidah yang lurus dan pemahaman agama yang moderat (wasathiyah). Kami berkomitmen menjaga sanad keilmuan para ulama salaf untuk membentuk generasi yang inklusif, toleran, dan terhindar dari pemahaman ekstrem.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Misi 3 -->
              <div class="border-b-2 border-lime-900/70">
                <button class="misi-toggle w-full py-4 flex justify-between items-center text-left focus:outline-none group">
                  <span class="text-lg lg:text-xl font-semibold text-lime-900 group-hover:text-lime-700 transition-colors">
                    Mempraktekkan Nilai Moral Islam dalam Keseharian
                  </span>
                  <svg class="arrow-icon w-6 h-6 text-lime-700 transition-transform duration-500 flex-shrink-0 ml-4 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
                <div class="misi-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="text-lime-900 text-base lg:text-lg leading-relaxed pb-4 pt-1">
                      Kami selalu berupaya memastikan ilmu diniyah yang dipelajari tidak hanya berhenti pada hafalan, melainkan terwujud dalam adab, tata krama, dan etika berinteraksi setiap harinya.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Misi 4 -->
              <div class="border-b-2 border-lime-900/70">
                <button class="misi-toggle w-full py-4 flex justify-between items-center text-left focus:outline-none group">
                  <span class="text-lg lg:text-xl font-semibold text-lime-900 group-hover:text-lime-700 transition-colors">
                    Membudayakan Tradisi Islam Nusantara
                  </span>
                  <svg class="arrow-icon w-6 h-6 text-lime-700 transition-transform duration-500 flex-shrink-0 ml-4 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
                <div class="misi-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="text-lime-900 text-base lg:text-lg leading-relaxed pb-4 pt-1">
                      Merawat warisan kearifan lokal peninggalan Wali Songo dan para ulama terdahulu. Kami mengintegrasikan praktik ibadah kultural seperti tahlil, istighosah, dan sholawat ke dalam detak jantung aktivitas santri.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Misi 5 -->
              <div class="border-b-2 border-lime-900/70">
                <button class="misi-toggle w-full py-4 flex justify-between items-center text-left focus:outline-none group">
                  <span class="text-lg lg:text-xl font-semibold text-lime-900 group-hover:text-lime-700 transition-colors">
                    Menyebarkan Nilai Kejujuran & Kemandirian
                  </span>
                  <svg class="arrow-icon w-6 h-6 text-lime-700 transition-transform duration-500 flex-shrink-0 ml-4 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </button>
                <div class="misi-content grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
                  <div class="overflow-hidden">
                  <p class="text-lime-900 text-base lg:text-lg leading-relaxed pb-4 pt-1">
                      Membentuk karakter santri yang paripurna untuk menyongsong masa depan. Melalui kemandirian hidup di pesantren, santri ditempa menjadi pribadi yang amanah, welas asih terhadap sesama, dan memiliki tanggung jawab penuh atas diri serta lingkungannya.
                    </p>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      <section class="relative w-screen left-1/2 -translate-x-1/2 mt-16 md:mt-24 overflow-hidden">
        
        <!-- The Gentle SVG Curve -->
        <!-- Menambahkan 'block' dan '-mb-[1px]' untuk mencegah munculnya celah 1px (white line glitch) antara SVG dan div di bawahnya -->
        <svg 
          class="relative w-full h-12 md:h-20 lg:h-28 text-lime-100/80 z-10 block -mb-[1px]" 
          viewBox="0 0 1440 100" 
          fill="currentColor" 
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M0 100 Q 720 0 1440 100 Z" />
        </svg>

        <!-- Main Content Area (Background continues seamlessly) -->
        <div class="w-full bg-lime-100/80 pt-8 md:pt-16 pb-24 md:pb-32">
          <div class="w-full max-w-[1300px] mx-auto px-4 lg:px-12">
            
            <!-- Section Title -->
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-lime-900 text-center mb-16 lg:mb-24 tracking-tight max-w-4xl leading-relaxed mx-auto">
              Bagaimana kami menafsirkan nilai tersebut pada gaya hidup di PPMHS?
            </h2>

            <!-- Two Column Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
              
              <div class="lg:col-span-5 relative w-full aspect-square flex items-center justify-center overflow-visible p-2 md:p-6">
                
                <!-- THE MASTER BLOB CONTAINER -->
                <!-- The transition-[border-radius] makes the shape warp smoothly over 700ms -->
                <div id="morphing-blob" class="relative w-full h-full overflow-hidden shadow-lg blob-shape-0 transition-[border-radius] duration-700 ease-in-out">
                  
                  <!-- Image 0: Spiritual -->
                  <img 
                    id="blob-img-0"
                    src={spiritualImg.src} 
                    alt="Spiritual Lifestyle" 
                    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-100 z-10"
                  />

                  <!-- Image 1: Social/Community -->
                  <img 
                    id="blob-img-1"
                    src={kemanusiaanImg.src} 
                    alt="Kemanusiaan" 
                    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0 z-0"
                  />

                  <!-- Image 2: Environment -->
                  <img 
                    id="blob-img-2"
                    src={alamImg.src} 
                    alt="Kelestarian Alam" 
                    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out opacity-0 z-0"
                  />

                </div>
              </div>

              <!-- RIGHT COLUMN: JIS Style Tabs & Content (7/12 width) -->
              <div class="lg:col-span-7 flex flex-col justify-start">
                
                <!-- Slider Menu Header -->
                <div class="flex flex-wrap md:flex-nowrap gap-4 md:gap-8 border-b-2 border-lime-200 mb-8 md:mb-10">
                  
                  <button class="lifestyle-tab relative pb-4 text-lg lg:text-xl font-semibold text-lime-900 border-b-4 border-lime-700 transition-colors focus:outline-none" data-index="0">
                    Spiritual
                  </button>
                  
                  <button class="lifestyle-tab relative pb-4 text-lg lg:text-xl font-semibold text-lime-900/50 border-b-4 border-transparent hover:text-lime-800 transition-colors focus:outline-none" data-index="1">
                    Kemanusiaan
                  </button>
                  
                  <button class="lifestyle-tab relative pb-4 text-lg lg:text-xl font-semibold text-lime-900/50 border-b-4 border-transparent hover:text-lime-800 transition-colors focus:outline-none" data-index="2">
                    Hubungan dengan Alam
                  </button>

                </div>

                <!-- Content Panels -->
                <div class="relative min-h-[200px]">
                  
                  <!-- Content 1 -->
                  <div id="panel-0" class="lifestyle-panel transition-opacity duration-500 opacity-100">
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      Kami meyakini bahwa segala bentuk pembelajaran harus bermuara pada penguatan kedekatan kepada Allah SWT. Rutinitas ibadah, zikir, dan pengkajian kitab suci bukan sekadar kewajiban formalistik. Hal ini adalah kebutuhan jiwa yang menuntun santri menemukan ketenangan batin di tengah dinamika dunia modern.
                    </p>
                  </div>

                  <!-- Content 2 -->
                  <div id="panel-1" class="lifestyle-panel transition-opacity duration-500 opacity-0 hidden absolute top-0 left-0">
                    <p class="text-lime-900 text-base lg:text-lg font-bold leading-loose">
                      Tingkat Institusi
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      Kami bekerja sama dengan berbagai lembaga pemerintah dan sekolah untuk memberdayakan sivitas pondok pesantren dan lingkungan sekitar pondok pesantren. Saat ini PPMHS menjalin hubungan erat dengan Kementerian Kesehatan Provinsi Jawa Timur dan Pusat Kesehatan Masyarakat melalui program:
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      1. Desa Satelit <span class="italic">Screening</span> TBC <span class="font-semibold">(Satria TBC)</span>
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      2. Santri Tanggap dan Peduli Kebersihan Menstruasi <span class="font-semibold">(Santun Menstruasi)</span>
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      3. Santri Tanggap dan Rutin Minum Tablet Tambah Darah <span class="font-semibold">(Santun TTD)</span>
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      4. Santri Bersama Hidup Sehat dengan Gizi Seimbang <span class="font-semibold">(Santri Berisi)</span>
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg font-bold leading-loose mt-8">
                      Individu
                    </p>
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      Kami menjunjung budaya toleransi dan apresiasi di kehidupan dan kegiatan pembelajaran sehari-hari, contoh: mengucapkan terimakasih setiap selesai pembelajaran.
                    </p>
                  </div>

                  <!-- Content 3 -->
                  <div id="panel-2" class="lifestyle-panel transition-opacity duration-500 opacity-0 hidden absolute top-0 left-0">
                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                      Sebagai penjaga bumi, kita memikul tanggung jawab besar terhadap keseimbangan ekosistem. Gaya hidup santri diintegrasikan dengan kesadaran lingkungan.
                    </p>

                    <p class="text-lime-900 text-base lg:text-lg leading-loose">
                    Contoh program:
                    (1) <span class="font-semibold">Zero food waste</span> - seluruh sampah makanan dijadikan pakan hewan atau pupuk kompos untuk lahan perkebunan pondok dan ladang petani di sekitar
                    dan (2) <span class="font-semibold">Bank sampah plastik</span> - daur ulang sampah botol dan kemasan plastik.
                    </p>
                  </div>

                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

    </main>
    <Footer />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggles = document.querySelectorAll('.misi-toggle');
        
        toggles.forEach(toggle => {
          toggle.addEventListener('click', () => {
            const content = toggle.nextElementSibling;
            const icon = toggle.querySelector('.arrow-icon');
            
            // 1. Check if the one we just clicked is currently closed
            const isClosed = content.classList.contains('grid-rows-[0fr]');
            
            // 2. Loop through ALL toggles and force them to close
            toggles.forEach(otherToggle => {
              const otherContent = otherToggle.nextElementSibling;
              const otherIcon = otherToggle.querySelector('.arrow-icon');
              
              // Force close the grid drawer and fade out
              otherContent.classList.remove('grid-rows-[1fr]', 'opacity-100');
              otherContent.classList.add('grid-rows-[0fr]', 'opacity-0');
              
              // Force arrow to point down
              otherIcon.classList.remove('rotate-180');
            });
            
            // 3. If the one we clicked was originally closed, open it now!
            // (If it was already open, step 2 just closed it, and it will stay closed)
            if (isClosed) {
              content.classList.remove('grid-rows-[0fr]', 'opacity-0');
              content.classList.add('grid-rows-[1fr]', 'opacity-100');
              icon.classList.add('rotate-180');
            }
          });
        });
      });

      document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.lifestyle-tab');
        const panels = document.querySelectorAll('.lifestyle-panel');
        
        // Grab the single blob container and all images inside it
        const morphingBlob = document.getElementById('morphing-blob');
        const blobImages = [
          document.getElementById('blob-img-0'),
          document.getElementById('blob-img-1'),
          document.getElementById('blob-img-2')
        ];

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetIndex = tab.getAttribute('data-index');

            // 1. Reset all Tabs
            tabs.forEach(t => {
              t.classList.remove('text-lime-900', 'border-lime-700');
              t.classList.add('text-lime-900/50', 'border-transparent');
            });

            // 2. Activate clicked Tab
            tab.classList.remove('text-lime-900/50', 'border-transparent');
            tab.classList.add('text-lime-900', 'border-lime-700');

            // 3. Hide all Panels
            panels.forEach(p => {
              p.classList.add('opacity-0');
              setTimeout(() => { p.classList.add('hidden', 'absolute'); }, 300);
            });

            // 4. Show targeted Panel
            setTimeout(() => {
              const activePanel = document.getElementById(`panel-${targetIndex}`);
              activePanel.classList.remove('hidden', 'absolute');
              setTimeout(() => { activePanel.classList.remove('opacity-0'); }, 50);
            }, 300);

            // 5. MORPH THE BLOB
            // Remove old shapes and add the new one based on the clicked index
            morphingBlob.classList.remove('blob-shape-0', 'blob-shape-1', 'blob-shape-2');
            morphingBlob.classList.add(`blob-shape-${targetIndex}`);

            // 6. CROSSFADE THE IMAGES
            blobImages.forEach((img, idx) => {
              if (idx == targetIndex) {
                // Fade in new image
                img.classList.remove('opacity-0', 'z-0');
                img.classList.add('opacity-100', 'z-10');
              } else {
                // Fade out other images
                img.classList.remove('opacity-100', 'z-10');
                img.classList.add('opacity-0', 'z-0');
              }
            });

          });
        });
      });
    </script>

  </body>

  <style>
    /* 1. Main container (48px tall). 24px radius creates a perfect half-circle on the left */
    .wur-cutout {
      border-top-left-radius: 32px;
      border-bottom-left-radius: 32px;
    }

    /* 2. The inverse curves are now exactly 24x24px to match the remaining flat edges */
    .wur-cutout::before,
    .wur-cutout::after {
      content: "";
      position: absolute;
      right: 0;
      width: 32px;
      height: 32px;
      background: transparent;
      pointer-events: none;
    }

    /* 3. Top Inverse Corner */
    .wur-cutout::before {
      bottom: 100%;
      background: radial-gradient(circle at 0 0, transparent 31.5px, #f7fee7 24px);
    }

    /* 4. Bottom Inverse Corner */
    .wur-cutout::after {
      top: 100%;
      background: radial-gradient(circle at 0 100%, transparent 31.5px, #f7fee7 24px);
    }

    /* This creates the asymmetrical, non-uniform frames */
  .blob-shape-0 {
    /* Spiritual shape */
    border-radius: 73% 27% 41% 59% / 43% 54% 46% 57%;
  }
  
  .blob-shape-1 {
    /* Social shape */
    border-radius: 39% 61% 47% 53% / 58% 39% 61% 42%;
  }
  
  .blob-shape-2 {
    /* Environment shape */
    border-radius: 54% 46% 30% 70% / 60% 36% 64% 40%;
  }
</style>
</html>