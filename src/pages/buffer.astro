---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sedang Dalam Pengembangan | PPMHS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50 min-h-screen flex flex-col">
    
    <Navbar hasDarkHero={false} />

    <main class="flex-1 flex items-center justify-center max-w-[1440px] w-full mx-auto px-4 lg:px-12 pt-28 pb-16">
      
      <!-- Main Editorial Container -->
      <div class="relative w-full max-w-[1200px] bg-lime-100/70 rounded-[2.5rem] lg:rounded-[4rem] p-8 md:p-14 lg:p-20 overflow-hidden">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Left Column: Animated 4-Piece Interlocking Puzzle SVG (5 columns) -->
          <div class="lg:col-span-5 flex justify-center">
            <svg 
              class="w-56 h-56 md:w-72 md:h-72 lg:w-80 lg:h-80 overflow-visible" 
              viewBox="0 0 240 240" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Ilustrasi kepingan puzzle yang menyatu dan runtuh"
            >
              <!-- Keping 1: Kiri Atas (Dua Cekungan ke Dalam) -->
              <path 
                class="puzzle-piece piece-1" 
                d="M 58 40 L 120 40 L 120 65 C 120 68, 117 69, 114 68 C 106 65, 98 70, 98 80 C 98 90, 106 95, 114 92 C 117 91, 120 92, 120 95 L 120 120 L 95 120 C 92 120, 91 117, 92 114 C 95 106, 90 98, 80 98 C 70 98, 65 106, 68 114 C 69 117, 68 120, 65 120 L 40 120 L 40 58 Q 40 40 58 40 Z" 
              />

              <!-- Keping 2: Kanan Atas (Dua Tonjolan Keluar) -->
              <path 
                class="puzzle-piece piece-2" 
                d="M 120 40 L 182 40 Q 200 40 200 58 L 200 120 L 175 120 C 172 120, 171 123, 172 126 C 175 134, 170 142, 160 142 C 150 142, 145 134, 148 126 C 149 123, 148 120, 145 120 L 120 120 L 120 95 C 120 92, 117 91, 114 92 C 106 95, 98 90, 98 80 C 98 70, 106 65, 114 68 C 117 69, 120 68, 120 65 L 120 40 Z" 
              />

              <!-- Keping 3: Kanan Bawah (Dua Cekungan ke Dalam) -->
              <path 
                class="puzzle-piece piece-3" 
                d="M 120 120 L 145 120 C 148 120, 149 123, 148 126 C 145 134, 150 142, 160 142 C 170 142, 175 134, 172 126 C 171 123, 172 120, 175 120 L 200 120 L 200 182 Q 200 200 182 200 L 120 200 L 120 175 C 120 172, 123 171, 126 172 C 134 175, 142 170, 142 160 C 142 150, 134 145, 126 148 C 123 149, 120 148, 120 145 L 120 120 Z" 
              />

              <!-- Keping 4: Kiri Bawah (Dua Tonjolan Keluar) -->
              <path 
                class="puzzle-piece piece-4" 
                d="M 40 120 L 65 120 C 68 120, 69 117, 68 114 C 65 106, 70 98, 80 98 C 90 98, 95 106, 92 114 C 91 117, 92 120, 95 120 L 120 120 L 120 145 C 120 148, 123 149, 126 148 C 134 145, 142 150, 142 160 C 142 170, 134 175, 126 172 C 123 171, 120 172, 120 175 L 120 200 L 58 200 Q 40 200 40 182 L 40 120 Z" 
              />
            </svg>
          </div>

          <!-- Right Column: Editorial Copy & Navigation (7 columns) -->
          <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
            
            <!-- Tag / Badge -->
            <div class="inline-block bg-lime-300 text-lime-900 text-xs md:text-sm font-bold px-3 py-1 mb-5 uppercase tracking-widest rounded-sm">
              Dalam Pengembangan
            </div>

            <!-- Big Heading -->
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-6 tracking-tight leading-tight">
              Uh oh, halaman ini sedang dalam pengembangan :)
            </h1>

            <!-- Editorial Paragraph -->
            <p class="text-lg lg:text-xl text-lime-900/80 leading-relaxed font-medium max-w-2xl">
              Halaman ini akan segera hadir setelah kami selesai menyiapkan seluruh informasi yang dibutuhkan. Jika Anda memerlukan informasi terkait secepatnya, <a href="/kontak" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 hover:decoration-lime-700 transition-colors">silakan hubungi kami</a>.
            </p>

            <p class="text-lg lg:text-xl text-lime-900/80 leading-relaxed font-medium mb-10 max-w-2xl">
              Sembari menunggu, silakan cermati pilihan program yang kami tawarkan atau kembali ke halaman utama.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
              
              <!-- Primary Button: Back to Home -->
              <a 
                href="/" 
                class="w-full sm:w-auto px-7 py-4 bg-lime-900 text-lime-50 rounded-full font-semibold flex items-center justify-center gap-3 hover:bg-lime-800 transition-colors group"
              >
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
                <span>Kembali ke Beranda</span>
              </a>

              <!-- Secondary Button: Go to Program Page -->
              <a 
                href="/program" 
                class="w-full sm:w-auto px-7 py-4 bg-lime-300/80 text-lime-900 rounded-full font-semibold flex items-center justify-center gap-3 hover:bg-lime-300 transition-colors group"
              >
                <span>Lihat Pilihan Program</span>
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>

            </div>

          </div>

        </div>

      </div>

    </main>

  </body>
  
  <style>
    .puzzle-piece {
      stroke-width: 1.5px;
      stroke-linejoin: round;
    }

    .piece-1 {
      transform-origin: 80px 80px;
      animation: puzzlePiece1 7.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    }

    .piece-2 {
      transform-origin: 160px 80px;
      animation: puzzlePiece2 7.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    }

    .piece-3 {
      transform-origin: 160px 160px;
      animation: puzzlePiece3 7.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    }

    .piece-4 {
      transform-origin: 80px 160px;
      animation: puzzlePiece4 7.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Keping 1 (Kiri Atas): Warna acuan #4d7c0f tetap konsisten dari awal hingga runtuh */
    @keyframes puzzlePiece1 {
      0%, 4% {
        transform: translate(-22px, -22px) rotate(-6deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      14%, 70% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      /* Retak */
      75% {
        transform: translate(-10px, -6px) rotate(-10deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      /* Runtuh ke bawah */
      87% {
        transform: translate(-28px, 65px) rotate(-32deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 0;
      }
      /* Reset posisi */
      91% {
        transform: translate(-22px, -22px) rotate(-6deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 0;
      }
      100% {
        transform: translate(-22px, -22px) rotate(-6deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
    }

    /* Keping 2 (Kanan Atas): Warna awal #84cc16 -> Melebur jadi #4d7c0f saat menempel ke Keping 1 */
    @keyframes puzzlePiece2 {
      0%, 14% {
        transform: translate(22px, -22px) rotate(6deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 1;
      }
      24% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 1;
      }
      26%, 70% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      /* Retak & kembali ke warna asli */
      75% {
        transform: translate(10px, -6px) rotate(10deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 1;
      }
      /* Runtuh ke bawah */
      87% {
        transform: translate(30px, 68px) rotate(35deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 0;
      }
      /* Reset posisi */
      91% {
        transform: translate(22px, -22px) rotate(6deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 0;
      }
      100% {
        transform: translate(22px, -22px) rotate(6deg);
        fill: #84cc16;
        stroke: #84cc16;
        opacity: 1;
      }
    }

    /* Keping 3 (Kanan Bawah): Warna awal #65a30d -> Melebur jadi #4d7c0f saat menempel */
    @keyframes puzzlePiece3 {
      0%, 28% {
        transform: translate(22px, 22px) rotate(-6deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 1;
      }
      38% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 1;
      }
      40%, 70% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      /* Retak & kembali ke warna asli */
      75% {
        transform: translate(12px, 10px) rotate(14deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 1;
      }
      /* Runtuh ke bawah */
      87% {
        transform: translate(34px, 75px) rotate(28deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 0;
      }
      /* Reset posisi */
      91% {
        transform: translate(22px, 22px) rotate(-6deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 0;
      }
      100% {
        transform: translate(22px, 22px) rotate(-6deg);
        fill: #65a30d;
        stroke: #65a30d;
        opacity: 1;
      }
    }

    /* Keping 4 (Kiri Bawah): Warna awal #a3e635 -> Melebur jadi #4d7c0f saat melengkapi puzzle */
    @keyframes puzzlePiece4 {
      0%, 42% {
        transform: translate(-22px, 22px) rotate(6deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 1;
      }
      52% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 1;
      }
      54%, 70% {
        transform: translate(0px, 0px) rotate(0deg);
        fill: #4d7c0f;
        stroke: #4d7c0f;
        opacity: 1;
      }
      /* Retak & kembali ke warna asli */
      75% {
        transform: translate(-12px, 10px) rotate(-14deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 1;
      }
      /* Runtuh ke bawah */
      87% {
        transform: translate(-32px, 72px) rotate(-28deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 0;
      }
      /* Reset posisi */
      91% {
        transform: translate(-22px, 22px) rotate(6deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 0;
      }
      100% {
        transform: translate(-22px, 22px) rotate(6deg);
        fill: #a3e635;
        stroke: #a3e635;
        opacity: 1;
      }
    }
  </style>

</html>