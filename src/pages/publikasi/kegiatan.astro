---
// src/pages/publikasi/kegiatan.astro
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/footer.astro';

const semuaPublikasi = await getCollection('publikasi');
const beritaKegiatan = semuaPublikasi
  .filter(item => item.data.kategori === "Berita Kegiatan")
  .sort((a, b) => new Date(b.data.tanggal).valueOf() - new Date(a.data.tanggal).valueOf());

const formatTanggalPendek = (dateString) => {
  if (!dateString) return "";
  const d = new Date(dateString);
  const tgl = d.getDate().toString().padStart(2, '0');
  const bln = (d.getMonth() + 1).toString().padStart(2, '0');
  const thn = d.getFullYear().toString().slice(-2);
  return `${tgl}/${bln}/${thn}`;
};

const tipeKegiatan = [
  "Pertemuan/Diskusi", 
  "Lokakarya/Workshop", 
  "Seminar", 
  "Kegiatan Internal",
  "Kegiatan Eksternal", 
  "Ekskursi", 
  "Studi Banding"
];
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kegiatan | PPMHS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50 text-lime-950 flex flex-col min-h-screen">
    
    <Navbar hasDarkHero={false} />

    <main class="flex-grow max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36 mb-20 w-full">
      
      <h1 class="text-3xl md:text-5xl font-bold text-lime-900 mb-10 tracking-tight">
        Kegiatan di Pondok Pesantren Miftahul Huda Soko
      </h1>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
        
        <!-- ==========================================
             1. TOMBOL FILTER MOBILE & SIDEBAR KIRI
             ========================================== -->
        
        <button id="btn-toggle-filter" class="lg:hidden w-full flex items-center justify-between bg-lime-900 text-lime-50 px-6 py-4 rounded-full font-bold shadow-md active:scale-95 transition-transform">
          <span>Filter kegiatan</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
        </button>

        <aside id="filter-sidebar" class="hidden lg:block bg-lime-100/70 p-6 md:p-8 rounded-[2rem] lg:sticky lg:top-32 border border-lime-900/5">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-lime-900">Filter</h2>
            <button id="btn-clear-filter" class="text-[10px] font-bold tracking-widest uppercase border border-lime-900/30 px-3 py-1.5 rounded-full hover:bg-lime-900 hover:text-lime-50 transition-colors cursor-pointer">
              Hapus Filter &times;
            </button>
          </div>

          <div class="border-t border-lime-900/10 pt-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-bold text-lime-900">Tipe Kegiatan</h3>
              <svg class="w-4 h-4 text-lime-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
            </div>
            <ul class="flex flex-col gap-3">
              {tipeKegiatan.map((tipe, index) => (
                <li class="flex items-center gap-3">
                  <input type="checkbox" id={`filter-${index}`} value={tipe} class="filter-checkbox w-4 h-4 rounded border-lime-900/30 text-lime-900 focus:ring-lime-900 bg-transparent cursor-pointer" />
                  <label for={`filter-${index}`} class="text-sm text-lime-900/80 cursor-pointer hover:text-lime-900">{tipe}</label>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- ==========================================
             2. KONTEN UTAMA (KANAN)
             ========================================== -->
        <div class="lg:col-span-3 flex flex-col gap-6">
          
          <div class="mb-2">
            <h2 class="text-2xl font-bold text-lime-900 mb-4">Kegiatan (<span id="result-count">{beritaKegiatan.length}</span> hasil)</h2>
            <div class="flex items-center bg-lime-100/70 rounded-full p-2 border border-lime-900/5 focus-within:border-lime-900/30 transition-colors">
              <input type="text" id="search-input" placeholder="Cari kegiatan..." class="w-full bg-transparent border-none outline-none px-4 text-lime-900 placeholder-lime-900/40" />
              <button class="w-10 h-10 flex-shrink-0 bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-950 hover:scale-105 transition-all cursor-default">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
              </button>
            </div>
          </div>

          <!-- Daftar Kartu Kegiatan -->
          <div class="flex flex-col gap-6" id="kegiatan-container">
            {beritaKegiatan.map((item) => {
              
              // Tipe Array
              const tipeAsli = item.data.tipe;
              const arrayTipe = Array.isArray(tipeAsli) ? tipeAsli : [tipeAsli || 'Kegiatan'];
              const dataTipeString = arrayTipe.join(',').toLowerCase();

              return (
                <a href={`/publikasi/${item.id}`} 
                   class="kegiatan-card group bg-lime-100/70 rounded-[2rem] p-4 md:p-6 flex flex-col md:flex-row gap-5 md:gap-8 hover:bg-lime-200/50 hover:scale-[1.02] hover:-translate-y-1 hover:shadow-xl hover:shadow-lime-900/10 hover:border-lime-900/20 transition-all duration-300 ease-out border border-lime-900/5 relative"
                   data-tipe={dataTipeString}
                   data-judul={item.data.judul.toLowerCase()}
                   data-deskripsi={item.data.deskripsi.toLowerCase()}>
                  
                  <!-- Gambar & Tanggal -->
                  <div class="relative w-full md:w-[280px] lg:w-[320px] h-56 md:h-[200px] flex-shrink-0 rounded-[1.25rem] overflow-hidden">
                    <img src={item.data.gambar?.src || item.data.gambar} alt={item.data.judul} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                    
                    <div class="absolute bottom-0 left-0 bg-lime-50 px-4 py-3.5 rounded-tr-2xl flex items-center gap-2 text-sm font-bold text-lime-900">
                      <svg class="w-4 h-4 text-lime-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                      {formatTanggalPendek(item.data.tanggal)}
                    </div>
                  </div>

                  <!-- Konten Teks -->
                  <div class="flex-1 flex flex-col justify-center py-2 md:py-2 md:pr-16 mb-12 md:mb-0">
                    <h3 class="text-xl md:text-2xl font-bold text-lime-900 mb-3 leading-snug group-hover:text-lime-700 transition-colors">{item.data.judul}</h3>
                    <p class="text-sm text-lime-900/80 leading-relaxed mb-5 line-clamp-2 md:line-clamp-3">{item.data.deskripsi}</p>
                    
                    <!-- Tag Tipe & Lokasi -->
                    <div class="flex flex-wrap gap-2 mt-auto">
                      {arrayTipe.map((t) => (
                        <span class="bg-lime-200/80 text-lime-900 text-[10px] font-bold px-2.5 py-1 uppercase tracking-widest rounded-sm">
                          {t}
                        </span>
                      ))}
                      <span class="bg-gray-200/80 text-gray-900 text-[10px] font-bold px-2.5 py-1 uppercase tracking-widest rounded-sm">
                        {item.data.lokasi || 'PPMHS'}
                      </span>
                    </div>
                  </div>

                  <!-- Tombol Kanan Bawah -->
                  <div class="absolute bottom-6 right-6 w-10 h-10 rounded-full bg-lime-900 text-lime-50 flex items-center justify-center group-hover:bg-lime-950 group-hover:scale-105 transition-all shadow-md">
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </div>

                </a>
              );
            })}
          </div>

          <!-- ==========================================
               3. PAGINATION
               ========================================== -->
          <div class="flex items-center justify-center gap-2 mt-10 mb-8">
            <button class="w-10 h-10 rounded-full border border-lime-900/30 flex items-center justify-center text-lime-900/40 cursor-not-allowed hover:bg-lime-900/5 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" /></svg>
            </button>
            <button class="w-10 h-10 rounded-full border border-lime-900/30 flex items-center justify-center text-lime-900/40 cursor-not-allowed hover:bg-lime-900/5 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            
            <div class="flex items-center gap-3 text-sm text-lime-900 mx-2">
              <span>Halaman</span>
              <div class="relative">
                <select class="appearance-none bg-lime-100/50 border border-lime-900/30 py-1.5 pl-3 pr-8 rounded font-semibold focus:outline-none focus:ring-1 focus:ring-lime-900 cursor-pointer">
                  <option>1</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-lime-900">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </div>
              </div>
              <span>dari 1</span>
            </div>

            <button class="w-10 h-10 rounded-full border border-lime-900 text-lime-900 flex items-center justify-center hover:bg-lime-900/10 transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
            <button class="w-10 h-10 rounded-full border border-lime-900 text-lime-900 flex items-center justify-center hover:bg-lime-900/10 transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" /></svg>
            </button>
          </div>

        </div>
      </div>
    </main>

    <Footer />
    
    <!-- MESIN JAVASCRIPT FINAL -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Toggle Sidebar Mobile
        const btnToggle = document.getElementById('btn-toggle-filter');
        const sidebar = document.getElementById('filter-sidebar');
        if (btnToggle && sidebar) {
          btnToggle.addEventListener('click', () => {
            sidebar.classList.toggle('hidden');
          });
        }

        // Mesin Pencari & Filter Anti-Gagal
        const searchInput = document.getElementById('search-input');
        const clearBtn = document.getElementById('btn-clear-filter');
        const checkboxes = document.querySelectorAll('.filter-checkbox');
        const cards = document.querySelectorAll('.kegiatan-card');
        const resultCount = document.getElementById('result-count');

        function filterCards() {
          const query = searchInput ? searchInput.value.toLowerCase().trim() : "";
          
          const activeFilters = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value.toLowerCase().trim());

          let count = 0;

          cards.forEach(card => {
            const judul = (card.getAttribute('data-judul') || "").toLowerCase();
            const deskripsi = (card.getAttribute('data-deskripsi') || "").toLowerCase();
            
            // KUNCI PERBAIKAN: Membelah tag menggunakan koma menjadi Array baru
            const tipeData = card.getAttribute('data-tipe') || "";
            const tipeArray = tipeData.split(',').map(t => t.trim());

            const matchesSearch = judul.includes(query) || deskripsi.includes(query);
            
            // Mencari apakah array tag di kartu ini mengandung tag yang dicentang
            const matchesFilter = activeFilters.length === 0 || activeFilters.some(filter => tipeArray.includes(filter));

            if (matchesSearch && matchesFilter) {
              card.style.display = 'flex';
              count++;
            } else {
              card.style.display = 'none';
            }
          });

          if(resultCount) resultCount.textContent = count;
        }

        if(searchInput) searchInput.addEventListener('input', filterCards);
        checkboxes.forEach(cb => cb.addEventListener('change', filterCards));

        // Tombol Hapus Filter
        if(clearBtn) {
          clearBtn.addEventListener('click', () => {
            checkboxes.forEach(cb => cb.checked = false);
            if(searchInput) searchInput.value = '';
            filterCards(); 
          });
        }
      });
    </script>
  </body>
</html>