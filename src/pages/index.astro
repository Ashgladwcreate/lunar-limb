---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/footer.astro';
import PilarKarakter from '../components/4PilarKarakterPPMHS.astro';
import heroImg from '../assets/hero.png';
import ProgramPilihan from '../components/ProgramPilihan.astro';

import { getCollection } from 'astro:content';

const semuaPublikasi = await getCollection('publikasi');
const beritaTerbaru = semuaPublikasi
  .filter(item => item.data.kategori === "Berita Kegiatan")
  .sort((a, b) => new Date(b.data.tanggal).valueOf() - new Date(a.data.tanggal).valueOf())
  .slice(0, 3); // Mengambil tepat 3 berita paling baru

const formatTanggalRingkas = (dateString) => {
  if (!dateString) return "";
  const d = new Date(dateString);
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
};
---

<html lang="id">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={true} />

    <!-- 1. Removed the max-w constraint from main so sections can stretch full-width -->
    <main class="w-full">
      
      <!-- ==========================================
           HERO CONTAINER (Keeps the 1440px max-width)
           ========================================== -->
      <div class="px-4 max-w-[1440px] mx-auto w-full">
        <div class="relative w-full h-[92vh] md:h-[700px] flex items-center justify-center overflow-hidden mt-4 rounded-3xl">
          
          <img 
            src={heroImg.src}  
            alt="School Campus" 
            class="absolute inset-0 w-full h-full object-cover z-0"
          />
          
          <div class="absolute inset-0 bg-black/40 z-10"></div>
          
          <div class="relative z-20 flex flex-col items-center text-center px-4 sm:px-6 gap-3 w-full max-w-4xl mx-auto">
            
            <p class="text-xs sm:text-sm md:text-base font-bold text-lime-300 uppercase tracking-widest drop-shadow-md">
              Selamat datang di Pondok Pesantren Miftahul Huda Soko
            </p>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight drop-shadow-lg">
              Your Next Step Toward a Bright Islamic Future!
            </h1>

            <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-8 w-full sm:w-auto px-6 sm:px-0">
              
              <a href="/visimisi" class="w-full sm:w-auto px-8 py-3.5 rounded-full border border-white bg-black/30 backdrop-blur-md text-white font-semibold transition-all duration-300 hover:bg-white hover:text-lime-900 flex items-center justify-center">
                Kenali Lebih Dekat
              </a>

              <a href="/pendaftaran" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-lime-300 text-black font-bold transition-all duration-300 hover:bg-lime-900 hover:text-white flex items-center justify-center">
                Daftar Sekarang!
              </a>
              
            </div>
          </div>
        </div>
      </div>

      <!-- ==========================================
           NEW OPENING REMARK (True Full Width)
           ========================================== -->
      <section class="relative w-full py-24 md:py-32 flex flex-col items-center justify-center">
        
        <div id="remark-text" class="relative z-10 px-6 max-w-4xl mx-auto flex flex-col items-center justify-center">
          
          <!-- Center Logo/Icon -->
          <div class="scroll-animate opacity-0 translate-y-8 scale-90 transition-all duration-[1500ms] ease-out w-12 h-12 md:w-16 md:h-16 text-[#2f5927] mb-8 mx-auto drop-shadow-sm flex justify-center">
            
            <svg viewBox="0 0 100 100" class="w-full h-full">
              
              <!-- Solid Block Dome -->
              <!-- Added 'Z' at the end of the path to close the shape at the bottom -->
              <path d="M 25 90 C 15 60 35 45 50 25 C 65 45 85 60 75 90 Z" fill="currentColor" />
              
              <!-- Thick Base Line -->
              <path d="M 15 90 L 85 90" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
              
              <!-- Spire connecting dome to moon -->
              <line x1="50" y1="13" x2="50" y2="25" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
              
              <!-- Crescent Moon -->
              <path d="M 49 12 A 5 5 0 1 1 56 6 A 6 6 0 1 0 49 12 Z" fill="currentColor" />
              
            </svg>
            
          </div>

          <!-- Text block -->
          <p class="text-lg md:text-xl font-medium text-lime-950 leading-relaxed md:leading-[2] text-center w-full">
            Di tengah dunia yang terus berubah dengan cepat, <span class="italic">sangat mudah bagi kita melupakan jati diri sebagai insan</span>. PPMHS membantu memberi pegangan yang kokoh melalui kedalaman spiritual dan nilai-nilai luhur agama Islam. Kami tidak hanya menempa akal, tetapi juga <span class="font-bold text-lime-600">merawat hati</span>, menginspirasi santri untuk <span class="font-bold text-lime-600">tumbuh menjadi pribadi yang luhur</span>.
          </p>
          
        </div>

      </section>

      <!-- ==========================================
           LOWER CONTENT CONTAINER (Restores max-width)
           ========================================== -->
      <div class="px-4 max-w-[1440px] mx-auto w-full">
        
        <div class="mt-8">
          <PilarKarakter />
        </div>

        <div>
          <ProgramPilihan />
        </div>

       <section class="relative w-full mt-24 mb-16 py-16 md:py-20 overflow-hidden">
          
          <!-- Gaya Animasi CSS Khusus Kendaraan -->
          <style>
            @keyframes melajuKiri {
              0% { right: -600px; }
              100% { right: 100%; }
            }
            
            /* Animasi Asap Baru */
            @keyframes mengepul {
              0% { transform: scale(0.3) translateX(0) translateY(0); opacity: 0.8; }
              100% { transform: scale(2.5) translateX(40px) translateY(-30px); opacity: 0; }
            }
            
            .mobil-berjalan {
              position: absolute;
              bottom: 2rem; 
              animation: melajuKiri 10s linear infinite; /* Kecepatan sudah dipercepat menjadi 15s */
              z-index: 0; 
              pointer-events: none; 
            }
            
            .asap {
              animation: mengepul 1.2s ease-out infinite;
            }
          </style>

          <!-- Garis Jalan -->
          <div class="absolute bottom-[2rem] left-0 w-full border-b-4 md:border-b-[6px] border-dashed border-lime-900/15 z-0"></div>

          <!-- Kendaraan Berjalan (Lewat di latar belakang) -->
          <div class="mobil-berjalan flex items-end">
            <!-- Bodi Minibus / Van (Raksasa) -->
            <svg class="w-[300px] md:w-[600px] h-auto text-lime-800 drop-shadow-xl" viewBox="0 0 100 50" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M90,20 L90,40 L10,40 L10,25 C10,15 20,10 30,10 L75,10 C85,10 90,15 90,20 Z" />
              <!-- Jendela -->
              <rect x="25" y="15" width="15" height="12" rx="2" fill="#f7fee7" />
              <rect x="45" y="15" width="15" height="12" rx="2" fill="#f7fee7" />
              <rect x="65" y="15" width="15" height="12" rx="2" fill="#f7fee7" />
              <!-- Lampu Depan -->
              <path d="M10,25 L13,25 L13,30 L10,30 Z" fill="#fef08a" />
              <!-- Roda -->
              <circle cx="25" cy="42" r="8" fill="#1f2937" />
              <circle cx="25" cy="42" r="3" fill="#9ca3af" />
              <circle cx="75" cy="42" r="8" fill="#1f2937" />
              <circle cx="75" cy="42" r="3" fill="#9ca3af" />
            </svg>
            
            <!-- Animasi Asap Knalpot -->
            <div class="absolute bottom-[2.5rem] md:bottom-[4.5rem] right-[30px] md:right-[45px]">
              <div class="asap absolute w-10 h-10 md:w-16 md:h-16 rounded-full bg-lime-900/20" style="animation-delay: 0s"></div>
              <div class="asap absolute w-10 h-10 md:w-16 md:h-16 rounded-full bg-lime-900/20" style="animation-delay: 0.4s"></div>
              <div class="asap absolute w-10 h-10 md:w-16 md:h-16 rounded-full bg-lime-900/20" style="animation-delay: 0.8s"></div>
            </div>
          </div>

          <div class="relative z-10 w-full max-w-[1440px] mx-auto px-4 lg:px-8">            
            <!-- Header Bagian -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
              <div>
                <div class="inline-block bg-lime-300 text-lime-900 text-[10px] md:text-xs font-bold px-3 py-1 mb-3 uppercase tracking-widest rounded-sm">
                  Berita Kegiatan
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-lime-900 tracking-tight">Jejak Langkah Santri</h2>
              </div>
              
              <a href="/publikasi/kegiatan" class="group flex items-center gap-3 text-lime-900 font-bold hover:text-lime-700 transition-colors w-max">
                Lihat seluruh berita kegiatan
                <div class="w-8 h-8 rounded-full bg-lime-300 flex items-center justify-center group-hover:bg-lime-900 group-hover:text-lime-50 transition-all duration-300">
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              
              <!-- 1. KARTU BERITA ASLI -->
              {beritaTerbaru.map((item) => {
                const tipeAsli = item.data.tipe;
                const badgeTipe = Array.isArray(tipeAsli) ? tipeAsli[0] : (tipeAsli || 'Kegiatan');

                return (
                  <a href={`/publikasi/${item.id}`} class="group flex flex-col bg-white rounded-[2rem] border border-lime-900/5 hover:border-lime-300 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 ease-out overflow-hidden relative">
                    
                    <div class="relative w-full h-56 md:h-64 overflow-hidden">
                      <img src={item.data.gambar?.src || item.data.gambar} alt={item.data.judul} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out" />
                      
                      <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-full text-xs font-bold text-lime-900 shadow-sm flex items-center gap-2">
                        <svg class="w-4 h-4 text-lime-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        {formatTanggalRingkas(item.data.tanggal)}
                      </div>
                    </div>

                    <div class="p-6 md:p-8 flex flex-col flex-grow">
                      <span class="text-[10px] font-extrabold uppercase tracking-widest text-lime-600 mb-3">{badgeTipe}</span>
                      <h3 class="text-xl md:text-2xl font-bold text-lime-950 mb-3 leading-snug group-hover:text-lime-700 transition-colors line-clamp-2">{item.data.judul}</h3>
                      <p class="text-sm text-gray-500 line-clamp-3 leading-relaxed mb-8">{item.data.deskripsi}</p>
                      
                      <div class="mt-auto flex items-center gap-2 text-sm font-bold text-lime-900">
                        Baca selengkapnya 
                        <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                      </div>
                    </div>
                  </a>
                );
              })}

              <!-- 2. KARTU PENGGANTI (Otomatis menyesuaikan sisa ruang) -->
              {Array.from({ length: Math.max(0, 3 - beritaTerbaru.length) }).map(() => (
                <div class="hidden md:flex flex-col relative overflow-hidden bg-gradient-to-br from-lime-50 to-lime-100/50 rounded-[2rem] border-2 border-dashed border-lime-900/15 p-8 items-center justify-center text-center min-h-[450px]">
                  
                  <!-- Lingkaran Ikon Animasi -->
                  <div class="w-20 h-20 rounded-full bg-lime-200/60 flex items-center justify-center text-lime-700 mb-6 animate-[bounce_3s_infinite]">
                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                  </div>
                  
                  <h3 class="text-xl font-bold text-lime-900 mb-3">Kisah Berikutnya...</h3>
                  <p class="text-sm text-lime-900/60 leading-relaxed max-w-[80%]">
                    Kami sedang merangkai dokumentasi kegiatan seru lainnya. Nantikan pembaruan dari PPMHS!
                  </p>
                  
                </div>
              ))}

            </div>
          </div>
        </section>


        <section class="relative w-[100vw] left-1/2 right-1/2 -mx-[50vw] mt-24 mb-16 overflow-hidden bg-lime-50 py-8">
          
          
          <div class="px-4 lg:px-12 max-w-[1440px] mx-auto w-full mb-8">
            <div class="inline-block bg-lime-300 text-lime-900 text-[10px] md:text-xs font-bold px-3 py-1 mb-3 uppercase tracking-widest rounded-sm">
              Video
            </div>

            <a href="https://www.youtube.com/@santrippmhs1331" target="_blank" class="group flex items-center gap-3 text-3xl md:text-5xl text-lime-900 font-bold hover:text-lime-700 transition-colors w-max">
                Sorotan Lensa Santri
                <div class="w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-lime-300 flex items-center justify-center group-hover:bg-lime-900 group-hover:text-lime-50 transition-all duration-300">
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </a>
          </div>

          <!-- Wadah Scroll Horizontal (Film Roll) -->
          <div class="w-full overflow-x-auto pb-8 hide-scrollbar cursor-grab active:cursor-grabbing" id="film-roll-container">
            
            <!-- Elemen Utama Film Roll (Lebar fleksibel) -->
            <div class="inline-flex items-center w-max px-4 md:px-12">
              
              <!-- Pembungkus Film Roll (Latar Hitam Kehijauan) -->
              <div class="relative bg-lime-950 flex p-6 md:p-8 rounded-lg shadow-2xl overflow-hidden border-4 border-lime-900">
                
                <!-- Ornamen Lubang Roll Film (Atas) -->
                <div class="absolute top-2 left-0 right-0 h-4 flex justify-between px-2 gap-3" aria-hidden="true">
                  {Array.from({ length: 40 }).map(() => (
                    <div class="w-4 h-4 md:w-5 md:h-5 bg-[#edf3cf] rounded-[2px] flex-shrink-0 opacity-80"></div>
                  ))}
                </div>

                <!-- Ornamen Lubang Roll Film (Bawah) -->
                <div class="absolute bottom-2 left-0 right-0 h-4 flex justify-between px-2 gap-3" aria-hidden="true">
                  {Array.from({ length: 40 }).map(() => (
                    <div class="w-4 h-4 md:w-5 md:h-5 bg-[#edf3cf] rounded-[2px] flex-shrink-0 opacity-80"></div>
                  ))}
                </div>

                <!-- Deretan Frame Video -->
                <div class="flex gap-4 md:gap-6 mt-4 mb-4">
                  
                  <!-- FRAME 1 -->
                  <div class="relative w-[300px] md:w-[450px] aspect-video bg-black rounded-md overflow-hidden flex-shrink-0 border border-lime-900/50 group">
                    <iframe 
                      class="w-full h-full" 
                      src="https://www.youtube.com/embed/5XneIayuPOI?rel=0&autoplay=1&mute=1" 
                      title="Video YouTube Santri 1" 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen>
                    </iframe>
                  </div>

                  <!-- FRAME 2 -->
                  <div class="relative w-[300px] md:w-[450px] aspect-video bg-black rounded-md overflow-hidden flex-shrink-0 border border-lime-900/50 group">
                    <iframe 
                      class="w-full h-full" 
                      src="https://www.youtube.com/embed/xTMQ9hyrkqQ?rel=0&autoplay=1&mute=1" 
                      title="Video YouTube Santri 2" 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen>
                    </iframe>
                  </div>

                  <!-- FRAME 3 -->
                  <div class="relative w-[300px] md:w-[450px] aspect-video bg-black rounded-md overflow-hidden flex-shrink-0 border border-lime-900/50 group">
                    <iframe 
                      class="w-full h-full" 
                      src="https://www.youtube.com/embed/1OG5gydTdLc?rel=0&autoplay=1&mute=1" 
                      title="Video YouTube Santri 3" 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen>
                    </iframe>
                  </div>

                  <!-- FRAME 4 -->
                  <div class="relative w-[300px] md:w-[450px] aspect-video bg-black rounded-md overflow-hidden flex-shrink-0 border border-lime-900/50 group">
                    <iframe 
                      class="w-full h-full" 
                      src="https://www.youtube.com/embed/3owvq4S8ePg?rel=0" 
                      title="Video YouTube Santri 4" 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                      allowfullscreen>
                    </iframe>
                  </div>
                  
                  <!-- Anda bisa terus menyalin blok FRAME di atas ke sini jika ada video tambahan -->

                </div>
              </div>
            </div>
          </div>

          <!-- Indikator Geser -->
          <div class="flex items-center justify-center gap-2 mt-2 text-lime-900/60 text-sm font-medium">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Geser untuk melihat video
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>

          <!-- Tambahkan CSS untuk menyembunyikan scrollbar bawaan browser -->
          <style>
            .hide-scrollbar::-webkit-scrollbar {
              display: none;
            }
            .hide-scrollbar {
              -ms-overflow-style: none;
              scrollbar-width: none;
            }
          </style>

          <!-- Skrip ringan agar pengguna PC bisa menggeser (drag) layaknya di HP -->
          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const slider = document.getElementById('film-roll-container');
              if(!slider) return;

              let isDown = false;
              let startX;
              let scrollLeft;

              slider.addEventListener('mousedown', (e) => {
                isDown = true;
                slider.classList.add('active');
                startX = e.pageX - slider.offsetLeft;
                scrollLeft = slider.scrollLeft;
              });
              slider.addEventListener('mouseleave', () => {
                isDown = false;
                slider.classList.remove('active');
              });
              slider.addEventListener('mouseup', () => {
                isDown = false;
                slider.classList.remove('active');
              });
              slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - slider.offsetLeft;
                const walk = (x - startX) * 2; // Kecepatan geser
                slider.scrollLeft = scrollLeft - walk;
              });
            });
          </script>
        </section>



        <!-- LOKASI SECTION -->
        <section class="mt-24 mb-24 w-full">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
            
            <div class="flex flex-col items-start pr-0 lg:pr-12">
              
              <h2 class="text-4xl lg:text-[3.5rem] font-bold text-lime-900 leading-tight mb-8">
                Kunjungi Lokasi<br />Utama Pondok Kami
              </h2>
              
              <p class="text-xl lg:text-2xl text-lime-800 leading-relaxed mb-10">
                Jl. Tunggul Wulung, RT.01/RW.02<br />
                Dusun Soko, Desa Menang, Kec. Pagu<br />
                Kab. Kediri, Jawa Timur 64183
              </p>
              
              <a 
                href="https://maps.app.goo.gl/JmBN9CfQie6RR1YC6" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 bg-lime-900 hover:bg-lime-300 text-lime-50 text-lg font-bold py-4 px-8 rounded-full shadow-md hover:text-lime-900 transition-all duration-300 active:scale-95 active:bg-lime-300 active:text-lime-900"
              >
                Kunjungi kami
                <svg class="w-6 h-6 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14m-7-7l7 7-7 7"></path>
                </svg>
              </a>
              
            </div>

            <div class="w-full h-[400px] lg:h-[500px] rounded-2xl overflow-hidden shadow-sm bg-gray-100">
              <iframe 
                src="https://maps.google.com/maps?q=MIFTAHUL+HUDA+ISLAMIC+BOARDING+SCHOOL+SUKO+Kediri&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>

          </div>
        </section>

      </div>
    </main>

    <Footer />
    
  </body>

  <script>
  // Wait for the page to load
  document.addEventListener('DOMContentLoaded', () => {
    
    // Set up the Intersection Observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // When the icon enters the screen
        if (entry.isIntersecting) {
          // Add visible classes (fade in, move up to normal position, scale to normal size)
          entry.target.classList.add('opacity-100', 'translate-y-0', 'scale-100');
          // Remove the hidden starting classes
          entry.target.classList.remove('opacity-0', 'translate-y-8', 'scale-90');
          
          // Stop observing once it has animated so it doesn't repeat unnecessarily
          observer.unobserve(entry.target);
        }
      });
    }, { 
      threshold: 0.2 // Triggers when 20% of the icon is visible on screen
    });

    // Find our icon and start observing it
    document.querySelectorAll('.scroll-animate').forEach((el) => {
      observer.observe(el);
    });
    
  });
</script>
</html>