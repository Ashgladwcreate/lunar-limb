---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import pendafatranImg from '../assets/pendaftaran.png';
import kitabImg from '../assets/kitab.jpg';
import tahfidzImg from '../assets/tahfidz.jpg';
import Footer from '../components/footer.astro';
---

<html lang="id">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pendaftaran</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-lime-50">
    
    <Navbar hasDarkHero={false} />

    <main class="max-w-[1440px] mx-auto px-4 lg:px-12 pt-28 lg:pt-36">
      
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-lime-900 mb-8 md:mb-8 lg:mb-12 tracking-tight md:pr-20 lg:pr-0">
        Pendaftaran Santri Baru PPMHS
      </h1>

      <div class="relative w-full">
        
        <img 
          src={pendafatranImg.src} 
          alt="Kegiatan Yayasan Miftahul Huda Soko" 
          class="w-full h-[350px] md:h-[500px] lg:h-[650px] object-cover rounded-[2.5rem] lg:rounded-[4rem]"
        />

        <div class="wur-cutout hidden lg:flex absolute top-1/2 -translate-y-1/2 right-0 w-16 h-16 bg-lime-50 items-center justify-center z-10">
          
          <button 
            class="w-13 h-13 bg-lime-900 text-lime-50 rounded-full flex items-center justify-center hover:bg-lime-950 transition-colors group cursor-pointer"
            aria-label="Scroll down"
            onclick="window.scrollBy({ top: 600, behavior: 'smooth' })"
          >
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>
          
        </div>
      
      </div>

      <section id="faq-pendaftaran" class="w-full max-w-[1300px] mx-auto mt-16 md:mt-24 lg:mt-32 mb-24 lg:px-12">
        
        <div class="inline-block bg-lime-300 text-lime-900 text-xs md:text-sm font-bold px-3 py-1 mb-4 uppercase tracking-widest rounded-sm">
          Informasi Awal
        </div>

        <h2 class="text-3xl lg:text-5xl font-bold text-lime-900 mb-6 lg:mb-10 tracking-tight">
          Pertanyaan Seputar Pendaftaran
        </h2>

        <div class="flex flex-col w-full border-t border-lime-900/20">
          
          <!-- FAQ 1: Cara Daftar -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-xl lg:text-2xl font-medium text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Bagaimana alur dan cara mendaftar di PPMHS?
              </span>
              <svg class="w-5 h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-8 pt-2 text-lime-900/80 text-base lg:text-lg leading-relaxed max-w-4xl space-y-4">
                <p>
                  Pendaftaran santri baru di Pondok Pesantren Miftahul Huda Soko dibuka secara fleksibel tanpa batasan gelombang khusus. Proses pendaftaran dilakukan melalui tahapan berikut:
                </p>
                <ol class="list-decimal list-inside space-y-2 font-medium text-lime-900">
                  <li>Mengisi data diri calon santri sekaligus mengunggah <span class="italic">(upload)</span> salinan digital dokumen persyaratan melalui formulir pendaftaran di bagian bawah halaman ini.</li>
                  <li>Menjelang hari masuk (kedatangan ke pondok), menyerahkan berkas fisik berupa fotokopi dokumen persyaratan ke sekretariat pondok untuk verifikasi akhir dan penempatan asrama.</li>
                </ol>
              </div>
            </div>
          </div>

          <!-- FAQ 2: Dokumen Persyaratan -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-xl lg:text-2xl font-medium text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Apa saja dokumen persyaratan yang perlu disiapkan?
              </span>
              <svg class="w-5 h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-8 pt-2 text-lime-900/80 text-base lg:text-lg leading-relaxed max-w-4xl">
                <p class="mb-4">
                  Mohon siapkan dokumen berikut dalam bentuk <span class="font-bold">file digital (foto/scan)</span> untuk diunggah pada formulir daring di bawah, serta <span class="font-semibold">berkas fisik (fotokopi) untuk diserahkan ke sekretariat</span> menjelang hari masuk:
                </p>
                <ul class="list-disc list-inside space-y-2 text-lime-900 font-medium">
                  <li>Kartu Keluarga (KK) dan Akta Kelahiran calon santri (file unggahan & fotokopi masing-masing 2 lembar).</li>
                  <li>KTP kedua orang tua atau wali (file unggahan & fotokopi 2 lembar).</li>
                  <li>Pas foto terbaru berbusana muslim/rapi (file unggahan & cetak ukuran 3x4 sebanyak 4 lembar).</li>
                  <li>Catatan riwayat kesehatan khusus (jika santri memiliki alergi atau kondisi medis tertentu).</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ 3: Biaya Pendidikan -->
          <div class="border-b border-lime-900/20 accordion-item">
            <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none accordion-btn group cursor-pointer">
              <span class="text-xl lg:text-2xl font-medium text-lime-900 group-hover:text-lime-700 transition-colors pr-6">
                Bagaimana rincian biaya pendaftaran dan syahriah bulanan?
              </span>
              <svg class="w-5 h-5 text-lime-900 transform transition-transform duration-300 chevron flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div class="max-h-0 overflow-hidden transition-[max-height] duration-500 ease-in-out accordion-content">
              <div class="pb-8 pt-2 text-lime-900/80 text-base lg:text-lg leading-relaxed max-w-4xl">
                <p>
                  Komponen biaya pendidikan di PPMHS dibagi menjadi tiga bagian utama: Uang Pangkal (dibayarkan sekali saat awal masuk), Syahriah atau SPP bulanan, serta biaya daftar ulang dan kitab di awal tahun ajaran baru. Besaran biaya menyesuaikan dengan jalur program yang dipilih (Program Kitab atau Program Tahfidz). 
                </p>
                <p class="mt-4">
                  Tabel perbandingan nominal lengkap untuk masing-masing program dapat Anda periksa langsung pada <a href="/program#biaya-pendidikan" class="text-lime-900 font-bold underline decoration-lime-700/50 underline-offset-4 hover:text-lime-700 hover:decoration-lime-700 transition-colors">bagian Rincian Biaya Pendidikan</a> di halaman Program.
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Link "Lebih Banyak" ke Halaman Kontak -->
        <div class="mt-8 flex justify-start">
          <a 
            href="/kontak" 
            class="inline-flex items-center gap-3 text-lg font-bold text-lime-900 hover:text-lime-700 transition-colors group"
          >
            <span class="underline decoration-lime-900/40 underline-offset-8 group-hover:decoration-lime-700">
              Lihat pertanyaan lebih banyak
            </span>
            <span class="w-9 h-9 rounded-full bg-lime-300 text-lime-900 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        </div>

      </section>

      <!-- ==========================================
           FORMULIR PENDAFTARAN SECTION
           ========================================== -->
      <section id="formulir-pendaftaran" class="w-full mx-auto mb-32 scroll-mt-28">
        <div class="bg-lime-100/70 rounded-[2.5rem] lg:rounded-[4rem] p-6 md:p-12 lg:p-16">
          
          <!-- PEMBUNGKUS FORMULIR (Akan disembunyikan setelah berhasil kirim) -->
          <div id="form-wrapper">
            <div class="max-w-2xl mb-10 lg:mb-14">
              <div class="inline-block bg-lime-300 text-lime-900 text-xs md:text-sm font-bold px-3 py-1 mb-4 uppercase tracking-widest rounded-sm">
                Formulir Daring
              </div>
              <h2 class="text-3xl lg:text-5xl font-bold text-lime-900 mb-4 tracking-tight">
                Formulir Pendaftaran Santri
              </h2>
              <p class="text-lg text-lime-900/80 leading-relaxed">
                Silakan pilih program pendidikan yang dituju, lengkapi seluruh rincian data diri, dan unggah dokumen persyaratan di bawah ini.
              </p>
            </div>

          <form id="form-pendaftaran-ppmhs" class="space-y-12">
            
            <!-- ==========================================
                 BAGIAN 1: PILIHAN PROGRAM (IMAGE CARDS)
                 ========================================== -->
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-lime-900 mb-2">
                1. Pilih Program Pendidikan <span class="text-red-600">*</span>
              </h3>
              <p class="text-sm md:text-base text-lime-900/70 mb-6">
                Klik pada salah satu pilihan program di bawah ini sesuai minat calon santri.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                
                <!-- Card 1: Program Kitab -->
                <label class="relative cursor-pointer group">
                  <input type="radio" name="entry.709398308" value="Program Kitab" class="peer sr-only" required />
                  
                  <div class="h-full bg-lime-50 rounded-[2rem] p-4 lg:p-6 border-2 border-lime-900/10 transition-all duration-300 hover:border-lime-900/40 peer-checked:border-lime-900 peer-checked:bg-lime-200/40 peer-checked:shadow-md flex flex-col">
                    <div class="relative w-full h-48 lg:h-56 rounded-[1.5rem] overflow-hidden mb-4">
                      <img src={kitabImg.src} alt="Program Kitab" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </div>
                    <span class="text-xl lg:text-2xl font-bold text-lime-900 px-1">Program Kitab</span>
                  </div>

                  <div class="w-9 h-9 rounded-full border-2 border-lime-900/30 bg-lime-50 text-transparent peer-checked:bg-lime-900 peer-checked:border-lime-900 peer-checked:text-lime-300 flex items-center justify-center transition-all duration-300 absolute top-8 right-8 lg:top-10 lg:right-10 shadow-sm">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </label>

                <!-- Card 2: Program Tahfidz -->
                <label class="relative cursor-pointer group">
                  <input type="radio" name="entry.709398308" value="Program Tahfidz" class="peer sr-only" required />
                  
                  <div class="h-full bg-lime-50 rounded-[2rem] p-4 lg:p-6 border-2 border-lime-900/10 transition-all duration-300 hover:border-lime-900/40 peer-checked:border-lime-900 peer-checked:bg-lime-200/40 peer-checked:shadow-md flex flex-col">
                    <div class="relative w-full h-48 lg:h-56 rounded-[1.5rem] overflow-hidden mb-4">
                      <img src={tahfidzImg.src} alt="Program Tahfidz" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </div>
                    <div class="px-1 flex flex-wrap items-center justify-between gap-2">
                      <span class="text-xl lg:text-2xl font-bold text-lime-900">Program Tahfidz</span>
                      <span class="text-xs font-bold bg-lime-300/80 text-lime-900 px-3 py-1 rounded-full">
                        Khusus Santri Putri
                      </span>
                    </div>
                  </div>

                  <div class="w-9 h-9 rounded-full border-2 border-lime-900/30 bg-lime-50 text-transparent peer-checked:bg-lime-900 peer-checked:border-lime-900 peer-checked:text-lime-300 flex items-center justify-center transition-all duration-300 absolute top-8 right-8 lg:top-10 lg:right-10 shadow-sm">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                </label>

              </div>
            </div>

            <hr class="border-lime-900/15" />

            <!-- ==========================================
                 BAGIAN 2: DATA DIRI CALON SANTRI
                 ========================================== -->
            <div>
              <h3 class="text-xl lg:text-2xl font-bold text-lime-900 mb-6">
                2. Identitas Calon Santri
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- entry.704223399 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Nama Lengkap Calon Santri <span class="text-red-600">*</span></label>
                  <input type="text" name="entry.704223399" required placeholder="Sesuai Akta Kelahiran" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- entry.72329184 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Nama Panggilan <span class="text-red-600">*</span></label>
                  <input type="text" name="entry.72329184" required placeholder="Nama panggilan sehari-hari" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- entry.2042165995 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Tempat Lahir <span class="text-red-600">*</span></label>
                  <input type="text" name="entry.2042165995" required placeholder="Kota/Kabupaten tempat lahir" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- entry.1944038293 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Tanggal Lahir <span class="text-red-600">*</span></label>
                  <input type="date" name="entry.1944038293" required class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- entry.1015670036 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Jenis Kelamin <span class="text-red-600">*</span></label>
                  <select 
                    id="select-jenis-kelamin" 
                    name="entry.1015670036" 
                    required 
                    class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors"
                  >
                    <option value="" disabled selected>Pilih Jenis Kelamin</option>
                    <option id="opt-laki" value="Laki - Laki">Laki - Laki</option>
                    <option value="Perempuan">Perempuan</option>
                  </select>
                  <p id="note-gender-tahfidz" class="hidden mt-1.5 text-xs text-lime-800 font-medium">
                    *Program Tahfidz hanya diperuntukkan bagi santri putri (Perempuan).
                  </p>
                </div>

                <!-- entry.331529746 (NIK Calon Santri - Wajib 16 Digit) -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">
                    NIK (Nomor Induk Kependudukan) <span class="text-red-600">*</span>
                  </label>
                  <input 
                    type="text" 
                    name="entry.331529746" 
                    inputmode="numeric"
                    minlength="16"
                    maxlength="16"
                    pattern="[0-9]{16}" 
                    required 
                    placeholder="16 digit NIK sesuai KK" 
                    oninput="this.value = this.value.replace(/[^0-9]/g, ''); this.setCustomValidity('');"
                    oninvalid="this.setCustomValidity('NIK harus terdiri dari tepat 16 digit angka.')"
                    class="peer w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 [&:not(:placeholder-shown):invalid]:border-red-600 transition-colors" 
                  />
                  <p class="mt-1.5 text-xs text-lime-900/60 peer-[&:not(:placeholder-shown):invalid]:hidden">
                    *Pastikan NIK berjumlah tepat 16 digit angka sesuai Kartu Keluarga.
                  </p>
                  <p class="mt-1.5 text-xs font-semibold text-red-600 hidden peer-[&:not(:placeholder-shown):invalid]:block">
                    NIK belum sesuai (wajib terisi tepat 16 digit angka).
                  </p>
                </div>

                <!-- entry.1032658681 -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Kewarganegaraan <span class="text-red-600">*</span></label>
                  <select name="entry.1032658681" required class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors">
                    <option value="Warga Negara Indonesia (WNI)" selected>Warga Negara Indonesia (WNI)</option>
                    <option value="Warga Negara Asing (WNA)">Warga Negara Asing (WNA)</option>
                  </select>
                </div>

                <!-- Anak ke & Jumlah Saudara -->
                <div class="grid grid-cols-2 gap-4">
                  <!-- entry.1567770694 -->
                  <div>
                    <label class="block text-sm font-bold text-lime-900 mb-2">Anak ke- <span class="text-red-600">*</span></label>
                    <input type="number" name="entry.1567770694" min="1" required placeholder="Contoh: 2" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                  </div>
                  <!-- entry.2105679234 -->
                  <div>
                    <label class="block text-sm font-bold text-lime-900 mb-2">Dari ... Bersaudara <span class="text-red-600">*</span></label>
                    <input type="number" name="entry.2105679234" min="1" required placeholder="Contoh: 3" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                  </div>
                </div>

                <!-- ==========================================
                     BLOK ALAMAT SANTRI (TERSTRUKTUR RAPI)
                     ========================================== -->
                <!-- entry.893759222 (Detail Jalan, Desa, Kecamatan) -->
                <div class="md:col-span-2">
                  <label class="block text-sm font-bold text-lime-900 mb-2">Alamat Lengkap Calon Santri <span class="text-red-600">*</span></label>
                  <textarea name="entry.893759222" rows="2" required placeholder="Nama Jalan, RT/RW, Dusun, Desa/Kelurahan, Kecamatan" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors"></textarea>
                </div>

                <!-- Kabupaten / Kota (Kiri) -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Kabupaten / Kota <span class="text-red-600">*</span></label>
                  <input type="text" name="kabupaten_santri" required placeholder="Contoh: Kab. Kediri" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- Provinsi (Kanan) -->
                <div>
                  <label class="block text-sm font-bold text-lime-900 mb-2">Provinsi <span class="text-red-600">*</span></label>
                  <input type="text" name="provinsi_santri" required placeholder="Contoh: Jawa Timur" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" />
                </div>

                <!-- entry.1519488344 (Email - OPSIONAL) -->
                <div class="md:col-span-2">
                  <label class="block text-sm font-bold text-lime-900 mb-2">
                    Alamat Email Aktif <span class="text-red-600">*</span>
                  </label>
                  <input 
                    type="email" 
                    name="entry.1519488344" 
                    required 
                    placeholder="contoh@gmail.com" 
                    oninvalid="this.setCustomValidity('Mohon masukkan alamat email aktif yang valid untuk pengiriman bukti pendaftaran.')"
                    oninput="this.setCustomValidity('')"
                    class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors" 
                  />
                  <p class="mt-1.5 text-xs text-lime-900/60">
                    *Bukti konfirmasi pendaftaran akan dikirimkan secara otomatis ke alamat email ini.
                  </p>
                </div>

                <!-- entry.1738912937 (Riwayat Penyakit / Catatan Khusus - OPSIONAL) -->
                <div class="md:col-span-2">
                  <label class="block text-sm font-bold text-lime-900 mb-1">
                    Riwayat Penyakit / Catatan Khusus <span class="text-lime-900/50 font-normal">(Opsional)</span>
                  </label>
                  <p class="text-xs md:text-sm text-lime-900/75 leading-relaxed mb-3">
                    Silakan deskripsikan kebutuhan khusus pendaftar untuk mendukung kegiatan dan kehidupan di pondok pesantren. Kebutuhan khusus termasuk riwayat penyakit, penyandang disabilitas, alergi makanan, atau kebutuhan lain yang memengaruhi aktivitas.
                  </p>
                  <textarea name="entry.1738912937" rows="3" placeholder="Tuliskan deskripsi kebutuhan khusus atau riwayat penyakit di sini (Kosongkan jika tidak ada)" class="w-full px-4 py-3.5 rounded-xl bg-lime-50 border border-lime-900/20 text-lime-900 focus:outline-none focus:border-lime-900 transition-colors"></textarea>
                </div>
              </div>
            </div>

