  <style>
    /* 1. Main container (48px tall). 24px radius creates a perfect half-circle on the left */
    .wur-cutout {
      border-top-left-radius: 32px;
      border-bottom-left-radius: 32px;
    }

    /* 2. The inverse curves are now exactly 24x24px to match the remaining flat edges */
    .wur-cutout::before,
    .wur-cutout::after {
      content: "";
      position: absolute;
      right: 0;
      width: 32px;
      height: 32px;
      background: transparent;
      pointer-events: none;
    }

    /* 3. Top Inverse Corner */
    .wur-cutout::before {
      bottom: 100%;
      background: radial-gradient(circle at 0 0, transparent 31.5px, #f7fee7 32px);
    }

    /* 4. Bottom Inverse Corner */
    .wur-cutout::after {
      top: 100%;
      background: radial-gradient(circle at 0 100%, transparent 31.5px, #f7fee7 32px);
    }

    /* Animasi panah naik berulang saat mengunggah berkas */
    @keyframes uploadArrowLoop {
      0% {
        transform: translateY(85%);
        opacity: 0;
      }
      30%, 70% {
        opacity: 1;
      }
      100% {
        transform: translateY(-85%);
        opacity: 0;
      }
    }

    .animate-upload-arrow {
      animation: uploadArrowLoop 1.1s infinite ease-in-out;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Logika Accordion FAQ
      const accBtns = document.querySelectorAll('.accordion-btn');
      
      accBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const content = this.nextElementSibling;
          const chevron = this.querySelector('.chevron');
          const isOpen = content.style.maxHeight;

          // Tutup semua tab yang sedang terbuka
          document.querySelectorAll('.accordion-content').forEach(c => {
            c.style.maxHeight = null;
          });
          document.querySelectorAll('.chevron').forEach(c => {
            c.classList.remove('rotate-180');
          });

          // Buka tab yang diklik jika sebelumnya tertutup
          if (!isOpen) {
            content.style.maxHeight = content.scrollHeight + "px";
            chevron.classList.add('rotate-180');
          }
        });
      });

      // 2. Logika Kunci Jenis Kelamin untuk Program Tahfidz
      const radioPrograms = document.querySelectorAll('input[name="entry.709398308"]');
      const selectGender = document.getElementById('select-jenis-kelamin');
      const optLaki = document.getElementById('opt-laki');
      const noteGenderTahfidz = document.getElementById('note-gender-tahfidz');

      radioPrograms.forEach(radio => {
        radio.addEventListener('change', function() {
          if (this.value === 'Program Tahfidz') {
            selectGender.value = 'Perempuan';
            optLaki.disabled = true;
            optLaki.hidden = true;
            noteGenderTahfidz.classList.remove('hidden');
          } else {
            optLaki.disabled = false;
            optLaki.hidden = false;
            noteGenderTahfidz.classList.add('hidden');
          }
        });
      });

      // 3. Logika Pengiriman Formulir & Upload File
      const form = document.getElementById('form-pendaftaran-ppmhs');
      const formWrapper = document.getElementById('form-wrapper');
      const successScreen = document.getElementById('success-screen');
      const sectionForm = document.getElementById('formulir-pendaftaran');
      const statusBox = document.getElementById('form-status');
      const submitBtn = document.getElementById('btn-submit-form');
      const submitText = document.getElementById('btn-submit-text');
      const iconDefault = document.getElementById('icon-submit-default');
      const iconUploading = document.getElementById('icon-submit-uploading');

      const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxJJTF0rLGs04EuVWegLqJcFZZeutqF9xlilD4fkb1V8L1dsOgdpEn9bk7Kk53PZIJj/exec";

      const fileToBase64 = (fileInput) => {
        return new Promise((resolve, reject) => {
          const file = fileInput.files[0];
          if (!file) return resolve(null);
          const reader = new FileReader();
          reader.onload = () => {
            const base64String = reader.result.split(',')[1];
            resolve({
              fileName: file.name,
              mimeType: file.type,
              base64: base64String
            });
          };
          reader.onerror = (error) => reject(error);
          reader.readAsDataURL(file);
        });
      };

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitText.textContent = "Mengunggah Data & Berkas...";
          statusBox.className = "hidden";

          // Sembunyikan panah kanan, tampilkan animasi panah naik
          iconDefault.classList.add('hidden');
          iconUploading.classList.remove('hidden');
          iconUploading.classList.add('flex');

          try {
            const formData = new FormData(form);
            const fields = {};
            formData.forEach((value, key) => {
              fields[key] = value;
            });

            // Jika opsi Laki-Laki sedang dikunci (Program Tahfidz), pastikan nilai Perempuan tetap terkirim
            if (selectGender && selectGender.value) {
              fields["entry.1015670036"] = selectGender.value;
            }

            const files = {
              passphoto: await fileToBase64(document.getElementById('file_passphoto')),
              akte: await fileToBase64(document.getElementById('file_akte')),
              kk: await fileToBase64(document.getElementById('file_kk')),
              ktp: await fileToBase64(document.getElementById('file_ktp'))
            };

            await fetch(SCRIPT_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify({ fields, files })
            });

            // Sembunyikan form dan tampilkan layar notifikasi besar
            form.reset();
            optLaki.disabled = false;
            optLaki.hidden = false;
            noteGenderTahfidz.classList.add('hidden');

            formWrapper.classList.add('hidden');
            successScreen.classList.remove('hidden');
            successScreen.classList.add('flex');
            
            // Gulir layar dengan mulus ke bagian atas kartu notifikasi
            sectionForm.scrollIntoView({ behavior: 'smooth' });

          } catch (error) {
            statusBox.textContent = "Maaf, terjadi kendala saat mengirim formulir. Silakan periksa koneksi internet Anda dan coba lagi.";
            statusBox.className = "block p-5 rounded-2xl text-base font-semibold bg-red-100 text-red-900 border border-red-900/20";
          } finally {
            submitBtn.disabled = false;
            submitText.textContent = "Kirim Pendaftaran";

            // Kembalikan ke panah kanan normal setelah selesai
            iconDefault.classList.remove('hidden');
            iconUploading.classList.add('hidden');
            iconUploading.classList.remove('flex');
          }
        });
      }
    });
  </script>

</html>